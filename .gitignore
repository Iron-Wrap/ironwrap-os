# OS / editor cruft
.DS_Store
.codegraph/
.cursor/
.impeccable/
.superdesign/tmp/

# Node / build
node_modules/
dist/
.lazyweb/

# Python
__pycache__/
*.pyc
build/
*.egg-info/

# Cloudflare / Wrangler (workers-bus)
.wrangler/
worker-configuration.d.ts

# Secrets — local only, never commit
.dev.vars
*.local
ACCESS.env
*.env
deploy/local/keys/

# Per-tenant Worker artifacts generated by deploy/clone-tenant.sh. The tenant CONFIG
# (config/tenants/<tenant>.json) is the reviewable source of truth and is committed; these
# two are derived from it plus live account facts, and .dev.vars.<tenant> holds throwaway
# credentials minted from that tenant's own Frappe site.
workers-bus/wrangler.*.jsonc
workers-bus/.dev.vars.*
!workers-bus/.dev.vars.example

# Scratch / logs / generated render artifacts
tmp/
output/
*.log
.gstack/
.runtime-logs/

# Nested product repo — own remote + branch discipline (see AGENTS.md repo map)
/Facet/
