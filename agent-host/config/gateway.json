{
  "schema": "ironwrap_agent_gateway_config_v2",
  "providers": {
    "claude": {
      "enabled": true,
      "auth": "oauth",
      "oauth_token_env": "CLAUDE_CODE_OAUTH_TOKEN",
      "api_key_env": "ANTHROPIC_API_KEY",
      "executable_path": null
    },
    "codex": {
      "enabled": true,
      "auth": "chatgpt",
      "api_key_env": "CODEX_API_KEY",
      "codex_home_env": "CODEX_HOME",
      "signin_max_age_hours": 216,
      "chatgpt_plans": ["pro"]
