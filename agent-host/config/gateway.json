      "specialist": { "calls": 60, "cost_usd": 3, "cost_usd_per_call": 0.5 }
    }
  },
  "retry": { "max_attempts": 3, "base_delay_ms": 2000, "max_delay_ms": 60000, "auth_probe_after_ms": 900000 },
  "timeout_ms": 240000,
