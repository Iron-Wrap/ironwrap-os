# Copy to /etc/ironwrap/agent-host.env with owner-only permissions. Values below are placeholders.
# The image fixes the state, Codex home and bind settings; set only what differs per host.

AGENT_HOST_IMAGE_TAG=<git-sha>
AGENT_HOST_ID=<broker-host-name>
AGENT_HOST_WORKER_URL=https://<worker-host>
# Must equal the Worker secret AGENT_HOST_TOKEN; it authorizes the agent API and nothing else.
AGENT_HOST_WORKER_TOKEN=<dedicated-agent-host-worker-token>

# Claude subscription sign-in from `claude setup-token`. With "auth": "api_key" in
# agent-host/config/gateway.json, set ANTHROPIC_API_KEY instead.
CLAUDE_CODE_OAUTH_TOKEN=<claude-setup-token>
# Codex signs in through $CODEX_HOME/auth.json on the volume (see agent-host/README.md). With
# "auth": "api_key" for Codex, set CODEX_API_KEY instead.

AGENT_HOST_POLL_MS=15000
AGENT_HOST_CONCURRENCY=4
