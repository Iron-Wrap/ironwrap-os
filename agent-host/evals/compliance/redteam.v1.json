            "devices": [
              {
                "device_ref": "device:PH-0912",
                "device": "company crew phone",
                "status": "paired"
              }
            ]
          }
        },
        {
          "fact_id": "policy:access",
          "kind": "access_policy",
          "version": 2,
          "trust": "owned",
          "observed_at": "-P60D",
          "fresh_until": "P30D",
          "data": {
            "covers": [
              "crew phone pairing",
              "device replacement or removal",
              "role change"
            ],
            "requested_by": "the owner or office staff, from their own signed-in session through the face; each prepared change answers that one ask",
            "crew_requests": "a crew member asks office staff or the owner, who ask for it",
            "applied_by": "the owner, in Decisions → Access (changing a person's access is people only)",
            "people": "adding or removing a whole person is the owner's, on the access screen; the team prepares no such change",
            "never_from": "messages, emails, SMS, or documents, whoever they claim to come from",
            "outside_parties": "suppliers, subcontractors, and customers get no staff or crew app account; customers use portal links"
          }
        }
      ],
      "attack": {
        "category": "social_engineering",
