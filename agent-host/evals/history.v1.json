      "sources": {
        "ghl": {
          "status": "awaiting_fields",
          "builder": "buildGhlLeadCases",
          "intake_window_minutes": 15,
          "conversion_horizon_days": 120,
          "intake_custom_fields": []
        },
        "jobnimbus": {
          "status": "awaiting_export",
          "builder": "buildLeadCases",
          "intake_window_minutes": 15,
          "conversion_horizon_days": 365,
          "min_outcome_age_days": 365,
          "status_change_pattern": "^(?:job )?status changed (?:from .+? )?to (.+?)$",
          "won_statuses": [
            "signed",
            "sold",
            "won",
            "closed won",
            "scheduled",
            "in progress",
            "in production",
            "work in progress",
            "completed",
            "complete",
            "job completed",
            "invoiced",
            "paid"
          ],
          "excluded_record_types": [
            "supplier",
            "vendor",
            "subcontractor",
            "sub",
            "employee",
            "adjuster",
            "insurance"
          ]
        }
      },
      "bars": [
        {
          "metric": "converted_dropped.rate",
          "max": 0.02,
          "min_n": 100,
          "gating": true
        },
        {
          "metric": "auc",
          "min": 0.7,
          "gating": false
        },
        {
          "metric": "converted_marked_qualified.rate",
          "min": 0.8,
          "gating": false
        },
        {
          "metric": "abstention.rate",
          "max": 0.15,
          "gating": false
        }
      ]
    },
    "scheduler_dispatcher": {
      "status": "awaiting_export",
      "outcome": "durationOutcome",
      "sample": 150,
      "sources": {
        "jobnimbus": {
          "status": "awaiting_export",
          "builder": "buildDurationCases",
          "decision_lead_days": 7,
          "completed_statuses": [
            "completed",
            "complete",
            "job completed",
            "invoiced",
            "paid"
          ]
        }
      },
      "bars": [
        {
          "metric": "abs_error_pct.p50",
          "max": 25,
          "gating": false
        },
        {
          "metric": "abs_error_pct.p90",
          "max": 60,
          "gating": false
        },
        {
          "metric": "error_pct.p50",
          "min": -10,
          "max": 10,
          "gating": false
        },
        {
          "metric": "abstention.rate",
          "max": 0.2,
          "gating": false
        }
      ]
    },
    "estimator": {
      "status": "awaiting_schema",
      "needs": [
        "estimate rows with totals, versions, and creation times",
        "measurement values per job",
        "actual job cost per job, for the margin and below-cost metrics"
      ],
      "sample": 150,
      "bars": [
        {
          "metric": "abs_error_vs_quoted_pct.p50",
          "max": 10,
          "gating": false
        },
        {
          "metric": "abs_error_vs_quoted_pct.p90",
          "max": 25,
          "gating": false
        },
        {
          "metric": "error_vs_quoted_pct.p50",
          "min": -5,
          "max": 5,
          "gating": false
        },
        {
          "metric": "margin_error_points.p50",
          "min": -5,
          "max": 5,
          "gating": false
        },
        {
          "metric": "below_actual_cost.rate",
          "max": 0.05,
          "gating": false
        },
        {
          "metric": "abstention.rate",
          "max": 0.2,
          "gating": false
        }
      ]
    },
    "billing_reconciliation": {
      "status": "awaiting_quickbooks",
      "needs": [
        "QuickBooks payments and deposits with their applications to invoices",
        "QuickBooks invoices with customer, amount, and creation time"
      ],
      "sample": 150,
      "bars": [
        {
          "metric": "cross_customer.rate",
          "max": 0,
          "gating": true
        },
        {
          "metric": "false_application.rate",
          "max": 0.01,
          "gating": true
        },
        {
          "metric": "exact_amount.rate",
          "min": 0.99,
          "gating": true
        },
        {
          "metric": "precision",
          "min": 0.98,
          "gating": false
        },
        {
          "metric": "recall",
          "min": 0.9,
          "gating": false
        }
      ]
    }
  }
