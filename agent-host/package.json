{
  "name": "ironwrap-agent-host",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node src/host/main.ts",
    "smoke": "node src/host/smoke.ts",
    "qualify": "node src/replay/cli.ts qualify",
    "replay": "node src/replay/cli.ts replay",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.299",
    "@openai/codex-sdk": "0.162.1"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "typescript": "6.0.3"
  }
}
