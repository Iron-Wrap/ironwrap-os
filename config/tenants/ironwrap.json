    "write_guard_envs": ["ERPNEXT_WRITE_ENABLED", "HERMES_DRY_RUN_SIGNING_KEY", "HERMES_APPROVAL_PUBLIC_KEY_FILE", "IRONWRAP_HERMES_APPROVAL_PUBLIC_KEY_FILE", "IRONWRAP_HERMES_SITE_BASE_URL"]
