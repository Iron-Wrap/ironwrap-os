# Copy to /etc/ironwrap/approval-broker.env, set owner-only permissions, and
# keep this lead-triage authority separate from quote-revision and production
# scheduling brokers. Values below are placeholders only.

ERPNEXT_BASE_URL=https://<frappe-origin>
ERPNEXT_API_KEY=<lead-concierge-frappe-api-key>
ERPNEXT_API_SECRET=<lead-concierge-frappe-api-secret>
ERPNEXT_REQUEST_TIMEOUT_MS=10000
ERPNEXT_WRITE_ENABLED=true

# This broker can invoke only the lead-triage dry-run/write pair under the
# lead-concierge role. It must not share a Frappe identity or broker secret with
# another approval authority.
HERMES_AGENT_ROLE=lead-concierge
HERMES_ACTOR_USER=lead-concierge@ironwrapexteriors.com
HERMES_APPROVER_ID=owner@ironwrapexteriors.com
HERMES_ROLE_POLICY_PATH=/srv/ironwrap/hermes/agents/roles.json
HERMES_DRY_RUN_SIGNING_KEY=<unique-at-least-32-byte-host-secret>
HERMES_APPROVAL_PUBLIC_KEY_FILE=/run/secrets/hermes-approval-public.pem
HERMES_APPROVAL_PRIVATE_KEY_FILE=/run/secrets/hermes-approval-private.pem

APPROVAL_BROKER_TENANT_ID=ironwrap
APPROVAL_BROKER_KEY_ID=approval-v1
APPROVAL_BROKER_SHARED_SECRET=<unique-at-least-32-byte-worker-broker-secret>
APPROVAL_BROKER_LISTEN_HOST=127.0.0.1
APPROVAL_BROKER_PORT=8788
APPROVAL_BROKER_MAX_CLOCK_SKEW_MS=60000
APPROVAL_BROKER_MAX_APPROVAL_LIFETIME_MS=300000
