# IronWrap OS launch env inventory. Copy the relevant block per host and fill
# values locally; NEVER commit filled copies. Names only, no real values here.

# ---- Locked runtimes / deployed image proof (deploy/runtime-lock.json) ----
FRAPPE_VERSION=v15.114.0
FRAPPE_COMMIT=105b17938839f4e5c6cdff817d42afc40c3bcc32
FRAPPE_DOCKER_VERSION=v3.2.1
FRAPPE_DOCKER_COMMIT=d4a310089f5d6fc38ed1317b898d75b9c74901db
HERMES_VERSION=v2026.7.7.2
HERMES_COMMIT=9de9c25f620ff7f1ce0fd5457d596052d5159596
IRONWRAP_OS_IMAGE=<registry>/ironwrap-os@sha256:<64-hex-digest>

# ---- Worker bus -> Frappe site (set via `wrangler secret put` / .dev.vars) ----
ERPNEXT_ENABLED=true
ERPNEXT_BASE_URL=https://os.ironwrapexteriors.com
ERPNEXT_API_KEY=<frappe-api-key>
ERPNEXT_API_SECRET=<frappe-api-secret>

# ---- Hermes / MCP servers (VM host env; consumed via hermes/mcp-servers.json) ----
IRONWRAP_BUS_BASE_URL=https://<worker-subdomain>.workers.dev
IRONWRAP_ADMIN_TOKEN=<bus-admin-token>
IRONWRAP_BUS_WRITE_ENABLED=false
ERPNEXT_WRITE_ENABLED=false
HERMES_WRITE_TOKEN=<approval-token-shared-with-approvers-only>
IRONWRAP_BUS_REQUEST_TIMEOUT_MS=10000
ERPNEXT_REQUEST_TIMEOUT_MS=10000

# ---- Launch proof script (tools/launch-proof.mjs, run from any machine) ----
BUS_BASE_URL=https://<worker-subdomain>.workers.dev
INGEST_TOKEN=<bus-ingest-token>
ADMIN_TOKEN=<bus-admin-token>

# ---- Nightly backup to R2 (deploy/backup-to-r2.sh via cron on the VM) ----
FRAPPE_SITE=os.ironwrapexteriors.com
BACKEND_CONTAINER=frappe-backend-1
RCLONE_CONFIG_R2_TYPE=s3
RCLONE_CONFIG_R2_PROVIDER=Cloudflare
RCLONE_CONFIG_R2_ACCESS_KEY_ID=<r2-access-key-id>
RCLONE_CONFIG_R2_SECRET_ACCESS_KEY=<r2-secret-access-key>
RCLONE_CONFIG_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BACKUP_BUCKET=ironwrap-backups
BACKUP_RETENTION_DAYS=14
BACKUP_AGE_RECIPIENT=<offline-age-public-recipient>

# ---- Isolated restore drill (deploy/restore-from-r2.sh) ----
# Select one exact marker-bearing prefix; the script never discovers "latest".
RESTORE_R2_COMPLETED_PREFIX=os.ironwrapexteriors.com/<YYYYMMDDTHHMMSSZ-pid-random>
# Local identity file must be absolute, non-symlinked, and mode 0400/0600.
RESTORE_AGE_IDENTITY_FILE=</absolute/path/to/offline-age-identity.txt>
# This container must differ from BACKEND_CONTAINER, run IRONWRAP_OS_IMAGE,
# carry the label com.ironwrap.restore-target=true, and have a target-only
# root_password in its site/common config so bench restore cannot prompt.
RESTORE_TARGET_SITE=restore-drill.ironwrap.invalid
RESTORE_TARGET_CONTAINER=frappe-restore-drill-1
# Keep unset for verification. For --restore, set just-in-time to the exact
# value RESTORE:<RESTORE_TARGET_SITE>@<RESTORE_TARGET_CONTAINER>.
RESTORE_CONFIRMATION=
