# IronWrap OS launch env inventory. Copy the relevant block per host and fill
# values locally; NEVER commit filled copies. Names only, no real values here.

# ---- Locked runtimes / deployed image proof (deploy/runtime-lock.json) ----
FRAPPE_VERSION=v15.114.0
FRAPPE_COMMIT=105b17938839f4e5c6cdff817d42afc40c3bcc32
FRAPPE_DOCKER_VERSION=v3.2.1
FRAPPE_DOCKER_COMMIT=d4a310089f5d6fc38ed1317b898d75b9c74901db
HERMES_VERSION=v2026.7.7.2
HERMES_COMMIT=9de9c25f620ff7f1ce0fd5457d596052d5159596
IRONWRAP_OS_IMAGE=<registry>/ironwrap-os@sha256:<64-hex-digest>

# ---- Worker bus -> Frappe site (set via `wrangler secret put` / .dev.vars) ----
# These are the Worker runtime's dedicated integration-user credentials. Do not
# reuse them for a Hermes MCP process.
EFFECT_RUNTIME_TOKEN=<dedicated-effect-runtime-token>
# Must equal the committed production Worker value in workers-bus/wrangler.jsonc: the
# Frappe projection is off in production (owner decision, 2026-09-27).
ERPNEXT_ENABLED=false
ERPNEXT_BASE_URL=https://os.ironwrapexteriors.com
ERPNEXT_API_KEY=<frappe-api-key>
ERPNEXT_API_SECRET=<frappe-api-secret>
ERPNEXT_TENANT_ID=ironwrap
OPERATING_AUTOMATION_USER=ironwrap-worker
# Exact Frappe User behind the Worker API key/secret. Public-estimator consent
# evidence uses this identity as its capture actor; it must match the
# site-local IRONWRAP_FIELD_EVIDENCE_ISSUER_USER allowlist below.
ERPNEXT_INTEGRATION_USER=worker@ironwrapexteriors.com

# ---- Optional OmniRoute LLM fallback (IRO-198) ----
# Self-hosted gateway: https://github.com/diegosouzapw/OmniRoute
# Origin only (no /v1). Cloudflare Workers need a public HTTPS URL; localhost
# works only for `wrangler dev` against a local OmniRoute process.
# OMNIROUTE_URL=https://<omniroute-host>
# Dashboard API key via `wrangler secret put OMNIROUTE_API_KEY` (maps to OmniRoute's
# OMNIROUTE_KEY). Optional: when unset, OCR keeps today's Anthropic-only fail-closed path.
# Keep MEASUREMENT_OCR_API_KEY in the secret inventory even if the Anthropic balance is
# empty - release-permit still requires that name when MEASUREMENT_OCR_ENABLED=true.

# ---- QuickBooks webhook -> bounded Frappe reconciliation issuer ----
# The realm is the one Intuit company this Worker may accept. It is a
# non-secret numeric company id, not a user or an accounting authorization.
QB_EXPECTED_REALM_ID=<quickbooks-company-realm-id>
# Set these only as Worker secrets. The issuer API pair belongs to a separate
# Frappe user with only the IronWrap QuickBooks Reconciliation Issuer role;
# never reuse the general Worker/MCP API pair or a human finance user.
QB_WEBHOOK_TOKEN=<intuit-webhook-verifier-token>
QB_RECONCILIATION_ISSUER_USER=quickbooks-issuer@ironwrapexteriors.com
QB_RECONCILIATION_ISSUER_API_KEY=<frappe-quickbooks-issuer-api-key>
QB_RECONCILIATION_ISSUER_API_SECRET=<frappe-quickbooks-issuer-api-secret>

# ---- Public instant estimate (Worker/PWA) ----
# This route is disabled by default. PUBLIC_ESTIMATE_ALLOWED_ORIGINS is the
# exact HTTPS origin that serves the PWA/Worker `/estimate` page, not a parent
# marketing site that embeds it. Parent sites are controlled separately by the
# `/estimate` frame-ancestors policy in app/public/_headers.
PUBLIC_ESTIMATE_ENABLED=false
PUBLIC_ESTIMATE_ALLOWED_ORIGINS=
# Exact tenant brand keys. The current IronWrap tenant uses ironwrap,iroof;
# each branded embed pins one of these in its /estimate?brand= link.
PUBLIC_ESTIMATE_ALLOWED_BRANDS=ironwrap,iroof
# Consent records must carry the tenant's explicit governing jurisdiction.
PUBLIC_ESTIMATE_CONSENT_JURISDICTION="Alberta, Canada"
PUBLIC_ESTIMATE_ALLOW_INSECURE_LOCAL=false
PUBLIC_ESTIMATE_TURNSTILE_SITE_KEY=
PUBLIC_ESTIMATE_RATE_LIMIT_WINDOW_SECONDS=900
PUBLIC_ESTIMATE_RATE_LIMIT_IP_MAX=12
PUBLIC_ESTIMATE_RATE_LIMIT_CLIENT_MAX=3
# Keep exactly []. Public intake never returns a price before verified measurement and
# approved pricing evidence; any non-empty value fails readiness.
PUBLIC_ESTIMATE_RANGE_RULES_JSON=[]
# Set these only with `wrangler secret put`; they are never browser values.
PUBLIC_ESTIMATE_TURNSTILE_SECRET=<turnstile-secret>
PUBLIC_ESTIMATE_RATE_LIMIT_PEPPER=<unique-at-least-32-byte-worker-secret>

# ---- Facet immutable design-evidence intake and review projection ----
# Keep each gate false until its same-environment proof in docs/LAUNCH-RUNBOOK.md is retained.
FACET_DESIGN_INGEST_ENABLED=false
# Readiness-only assertion: copy the exact Facet producer owner/tenant id after review.
# The map below must contain exactly this one source key.
FACET_DESIGN_INGEST_SOURCE_TENANT_ID=<reviewed-facet-owner-tenant-id>
# V2 requires the same exact source tenant plus local tenant/brand allowlist, for example:
# {"facet-production":{"tenant_id":"ironwrap","brand_ids":["ironwrap","iroof"]}}
FACET_DESIGN_INGEST_TENANT_MAP_JSON={}
FACET_DESIGN_INGEST_HMAC_KEY=<distinct-at-least-32-byte-ingress-secret>
FACET_DESIGN_FRAPPE_PROJECTION_ENABLED=false
FACET_DESIGN_FRAPPE_PROJECTION_HMAC_KEY=<distinct-at-least-32-byte-projection-secret>
FACET_DESIGN_FRAPPE_PROJECTION_FRAPPE_API_KEY=<dedicated-projection-user-api-key>
FACET_DESIGN_FRAPPE_PROJECTION_FRAPPE_API_SECRET=<dedicated-projection-user-api-secret>

# Dedicated per-rail Frappe issuers for fleet capture and work package (ELEC-56). Each pair
# belongs to its own least-privilege Frappe user; neither may repeat ERPNEXT_API_KEY/SECRET.
# The Worker refuses a repeated value and /ready reports rail_credential_isolation: false.
FLEET_CAPTURE_FRAPPE_API_KEY=<dedicated-fleet-capture-issuer-api-key>
FLEET_CAPTURE_FRAPPE_API_SECRET=<dedicated-fleet-capture-issuer-api-secret>
WORK_PACKAGE_FRAPPE_API_KEY=<dedicated-work-package-issuer-api-key>
WORK_PACKAGE_FRAPPE_API_SECRET=<dedicated-work-package-issuer-api-secret>

# ---- Frappe site config (set with `bench --site ... set-config`) ----
# This must be the exact non-interactive user that owns the Worker API pair
# above. It is not a Worker secret. The field-evidence issuer fails closed
# until this site-local allowlist is configured.
IRONWRAP_FIELD_EVIDENCE_ISSUER_USER=worker@ironwrapexteriors.com
# This exact, separate Frappe user must match
# QB_RECONCILIATION_ISSUER_USER above. Set it as the
# ironwrap_quickbooks_reconciliation_issuer_user site config key; Frappe
# rejects the bounded QuickBooks issuer when its session principal or role drifts.
IRONWRAP_QUICKBOOKS_RECONCILIATION_ISSUER_USER=quickbooks-issuer@ironwrapexteriors.com
# Launch proof uses a separate non-Desk Frappe API user. Give it only the
# `IronWrap Launch Proof Reader` role, then pin that exact user with this
# lower-case Frappe site-config key; do not give it Lead Envelope, Roof Job,
# Roofing Customer, or other app roles.
# ironwrap_launch_proof_reader_user=<dedicated-launch-proof-reader-user>
# Mount this public key into the Frappe backend too. Frappe independently
# verifies the signed, short-lived approval capability at its mutation boundary;
# it never receives the approval private key or dry-run HMAC secret.
IRONWRAP_HERMES_APPROVAL_PUBLIC_KEY_FILE=/run/secrets/hermes-approval-public.pem
# Set this to the same public ERPNEXT_BASE_URL used by the MCP host. Both
# runtimes normalize its public URL before hashing, binding receipt verification
# to this Frappe site without relying on input formatting.
IRONWRAP_HERMES_SITE_BASE_URL=https://os.ironwrapexteriors.com
# Local development only: this must be true only when the MCP host also has
# ERPNEXT_ALLOW_INSECURE_LOCAL=true for http://localhost, never in production.
# IRONWRAP_HERMES_ALLOW_INSECURE_LOCAL=false

# ---- Restricted insurance-evidence browser access (optional Worker BFF var) ----
# Owner access is always server-gated; add only reviewed Frappe estimator identities here.
# Broad app `ops` access alone never grants supplement reads.
APP_INSURANCE_ESTIMATOR_FRAPPE_USERS=estimator@ironwrapexteriors.com
# Comma-separated exact HTTPS origins permitted to render visual-model preview images in the
# office estimator workbench. This is not a CORS allowlist; leave blank until the preview origin
# and retention/provenance controls have been reviewed.
APP_VISUAL_PREVIEW_ALLOWED_ORIGINS=

# ---- MCP servers (VM host env for the bus, Frappe, and Newo MCP processes) ----
# Each MCP process registers only the tools its launching host lists here and refuses to
# start without the list or with a name it does not have. Set it per process, never shared.
MCP_ALLOWED_TOOLS=<comma-separated-tool-names-this-process-may-call>
IRONWRAP_BUS_BASE_URL=https://<worker-subdomain>.workers.dev
IRONWRAP_ADMIN_TOKEN=<bus-admin-token>
IRONWRAP_BUS_WRITE_ENABLED=false
HERMES_WRITE_TOKEN=<bus-replay-approval-token-only>
ERPNEXT_WRITE_ENABLED=false
# Writable Frappe MCP processes fail closed unless they can claim and settle
# every provider mutation through these Worker effect-runtime endpoints.
IRONWRAP_EFFECT_RUNTIME_ENABLED=true
IRONWRAP_EFFECT_RUNTIME_URL=https://<worker-subdomain>.workers.dev
IRONWRAP_EFFECT_RUNTIME_TOKEN=<same-dedicated-effect-runtime-token>
# One Frappe MCP process is launched per canonical agent role + authenticated actor.
# Its ERPNEXT_API_KEY/ERPNEXT_API_SECRET must be a separate token pair issued to
# exactly HERMES_ACTOR_USER; the Frappe safety command rejects shared-service
# impersonation. Supply those values only in the MCP process environment.
HERMES_AGENT_ROLE=owner-operator
HERMES_ACTOR_USER=owner@ironwrapexteriors.com
# This identity is bound to the approval broker's signing key, not supplied by an agent.
HERMES_APPROVER_ID=owner@ironwrapexteriors.com
HERMES_DRY_RUN_SIGNING_KEY=<unique-at-least-32-byte-host-secret>
# Public key only; the approval broker/owner workflow holds the matching private key.
# This is the MCP host mount; mirror the same public-key-only file into the
# Frappe backend as IRONWRAP_HERMES_APPROVAL_PUBLIC_KEY_FILE above.
HERMES_APPROVAL_PUBLIC_KEY_FILE=/run/secrets/hermes-approval-public.pem
# Authority mutations use a separate internal Worker executor rail. The MCP
# process claims one D1 action, writes through the exact Frappe actor below,
# reads the material record back, and only then terminalizes that D1 action.
# The HMAC key is host/Worker secret material; issuer public keys are the
# configured genuine external issuer keys and never a private signing key.
IRONWRAP_AUTHORITY_BUS_URL=https://<worker-subdomain>.workers.dev
IRONWRAP_AUTHORITY_EXECUTOR_HMAC_KEY=<unique-at-least-32-byte-authority-executor-secret>
IRONWRAP_AUTHORITY_EXECUTOR_USER_ID=<active-d1-owner-or-ops-user-id>
IRONWRAP_AUTHORITY_FRAPPE_ACTOR_USER_ID=<exact-frappe-owner-or-production-user>
IRONWRAP_AUTHORITY_BUSINESS_ROLE=IronWrap Production
AUTHORITY_ISSUER_PUBLIC_KEYS_JSON='{"issuer-key-id":"<ed25519-public-key>"}'
IRONWRAP_BUS_REQUEST_TIMEOUT_MS=10000
ERPNEXT_REQUEST_TIMEOUT_MS=10000
IRONWRAP_BUS_ALLOW_INSECURE_LOCAL=false

# ---- Retained Worker compatibility bindings for historical approval records ----
# The ERPNext broker launch package is retired. The supported defaults keep these
# origins and key IDs empty and the preparation/publication flags off. The
# name-only secret placeholders document retained readiness inputs.
APP_APPROVAL_BROKER_URL=
APP_APPROVAL_BROKER_KEY_ID=
APP_APPROVAL_APPROVER_ID=owner@ironwrapexteriors.com
APP_APPROVAL_MAX_SESSION_AGE_SECONDS=900
APP_APPROVAL_BROKER_TIMEOUT_MS=15000
APP_APPROVAL_EXECUTION_LEASE_SECONDS=45
APPROVAL_BROKER_SHARED_SECRET=<unique-at-least-32-byte-worker-broker-secret>
APP_FACET_QUOTE_REVISION_PREPARE_ENABLED=false
APP_QUOTE_REVISION_BROKER_URL=
APP_QUOTE_REVISION_BROKER_KEY_ID=
APP_QUOTE_REVISION_BROKER_TIMEOUT_MS=15000
APP_QUOTE_REVISION_EXECUTION_LEASE_SECONDS=45
QUOTE_REVISION_BROKER_SHARED_SECRET=<distinct-at-least-32-byte-quote-revision-secret>
APP_PROPOSAL_PUBLICATION_ENABLED=false
APP_PROPOSAL_PUBLICATION_BROKER_URL=
APP_PROPOSAL_PUBLICATION_BROKER_KEY_ID=
APP_PROPOSAL_PUBLICATION_BROKER_TIMEOUT_MS=15000
APP_PROPOSAL_PUBLICATION_EXECUTION_LEASE_SECONDS=45
PROPOSAL_PUBLICATION_BROKER_SHARED_SECRET=
APP_PRODUCTION_SCHEDULE_BROKER_URL=
APP_PRODUCTION_SCHEDULE_BROKER_KEY_ID=
APP_PRODUCTION_SCHEDULE_APPROVER_ID=owner@ironwrapexteriors.com
APP_PRODUCTION_SCHEDULE_MAX_SESSION_AGE_SECONDS=900
APP_PRODUCTION_SCHEDULE_BROKER_TIMEOUT_MS=15000
APP_PRODUCTION_SCHEDULE_EXECUTION_LEASE_SECONDS=45
PRODUCTION_SCHEDULE_BROKER_SHARED_SECRET=

# ---- Launch proof script (tools/launch-proof.mjs, run from any machine) ----
BUS_BASE_URL=https://<worker-subdomain>.workers.dev
INGEST_TOKEN=<bus-ingest-token>
ADMIN_TOKEN=<bus-admin-token>
# These credentials must belong only to the Frappe user pinned in
# `ironwrap_launch_proof_reader_user`; never reuse the Worker integration pair.
FRAPPE_BASE_URL=https://os.ironwrapexteriors.com
FRAPPE_API_KEY=<launch-proof-reader-frappe-api-key>
FRAPPE_API_SECRET=<launch-proof-reader-frappe-api-secret>
FRAPPE_PROOF_POLL_ATTEMPTS=3
FRAPPE_PROOF_POLL_INTERVAL_MS=1000

# ---- Nightly backup to R2 (deploy/backup-to-r2.sh via cron on the VM) ----
FRAPPE_SITE=os.ironwrapexteriors.com
# Example only: discover the real backend container from the deployed compose project
# before backup/restore; do not treat this sample value as live-proof truth.
BACKEND_CONTAINER=frappe_docker-backend-1
RCLONE_CONFIG_R2_TYPE=s3
RCLONE_CONFIG_R2_PROVIDER=Cloudflare
RCLONE_CONFIG_R2_ACCESS_KEY_ID=<r2-access-key-id>
RCLONE_CONFIG_R2_SECRET_ACCESS_KEY=<r2-secret-access-key>
RCLONE_CONFIG_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BACKUP_BUCKET=ironwrap-backups
BACKUP_RETENTION_DAYS=14
BACKUP_AGE_RECIPIENT=<offline-age-public-recipient>

# ---- Canonical D1 export to encrypted R2 (deploy/backup-d1-to-r2.sh) ----
# This token is name-only here and needs D1 read/export authority for the exact
# account/database below. Never reuse it as either dedicated backup R2 key.
D1_BACKUP_API_TOKEN=<cloudflare-d1-read-export-api-token>
D1_PRODUCTION_ACCOUNT_ID=5023dd227b538fc4238439fd7d52640f
D1_PRODUCTION_DATABASE_NAME=ironwrap-bus
D1_PRODUCTION_DATABASE_ID=a8fd0116-7af6-4788-98bd-083addbe58bc
D1_R2_BACKUP_BUCKET=ironwrap-backups
D1_BACKUP_RETENTION_DAYS=30

# ---- Isolated restore drill (deploy/restore-from-r2.sh) ----
# Select one exact marker-bearing prefix; the script never discovers "latest".
RESTORE_R2_COMPLETED_PREFIX=os.ironwrapexteriors.com/<YYYYMMDDTHHMMSSZ-pid-random>
# Local identity file must be absolute, non-symlinked, and mode 0400/0600.
RESTORE_AGE_IDENTITY_FILE=</absolute/path/to/offline-age-identity.txt>
# This container must differ from BACKEND_CONTAINER, run IRONWRAP_OS_IMAGE,
# carry the label com.ironwrap.restore-target=true, and have a target-only
# root_password in its site/common config so bench restore cannot prompt.
RESTORE_TARGET_SITE=restore-drill.ironwrap.invalid
RESTORE_TARGET_CONTAINER=frappe-restore-drill-1
# Keep unset for verification. For --restore, set just-in-time to the exact
# value RESTORE:<RESTORE_TARGET_SITE>@<RESTORE_TARGET_CONTAINER>.
RESTORE_CONFIRMATION=

# ---- D1 recovery verification / isolated remote drill ----
# Inject this separate D1 write token just-in-time for D1_RESTORE_MODE=remote.
# It must remain unset for verify and must never be stored in backup.env.
D1_RESTORE_API_TOKEN=<cloudflare-d1-restore-drill-api-token>
# Select one exact marker-bearing prefix. No script discovers "latest".
D1_RESTORE_R2_COMPLETED_PREFIX=d1/ironwrap-bus/<YYYYMMDDTHHMMSSZ-pid-random>
D1_RESTORE_AGE_IDENTITY_FILE=</absolute/path/to/offline-age-identity.txt>
# verify is local and non-mutating. Change to remote only for one approved drill.
D1_RESTORE_MODE=verify
D1_RESTORE_TARGET_ACCOUNT_ID=5023dd227b538fc4238439fd7d52640f
D1_RESTORE_TARGET_DATABASE_NAME=ironwrap-restore-drill-monthly
D1_RESTORE_TARGET_DATABASE_ID=<different-non-production-d1-uuid>
# Keep unset for verify. Set just-in-time for remote to the exact value
# RESTORE_D1:<D1_RESTORE_TARGET_DATABASE_NAME>@<D1_RESTORE_TARGET_DATABASE_ID>.
D1_RESTORE_CONFIRMATION=
