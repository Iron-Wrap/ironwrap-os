# Copy to /etc/ironwrap/production-schedule-approval-broker.env, set owner-only
# permissions, and keep it separate from every other broker environment. This
# process has its own production-controller Frappe credential, HMAC secret,
# signing material, actor, and port.

ERPNEXT_BASE_URL=https://<frappe-origin>
ERPNEXT_API_KEY=<production-controller-frappe-api-key>
ERPNEXT_API_SECRET=<production-controller-frappe-api-secret>
ERPNEXT_REQUEST_TIMEOUT_MS=10000
ERPNEXT_WRITE_ENABLED=true
IRONWRAP_EFFECT_RUNTIME_ENABLED=true
IRONWRAP_EFFECT_RUNTIME_URL=https://<worker-subdomain>.workers.dev
IRONWRAP_EFFECT_RUNTIME_TOKEN=<dedicated-worker-admin-token>

# This broker can invoke exactly dry_run_job_assignment and
# request_create_job_assignment under the production-controller policy. It
# cannot run as owner-operator, estimator-assistant, or any browser identity.
HERMES_AGENT_ROLE=production-controller
HERMES_ACTOR_USER=production-controller@ironwrapexteriors.com
HERMES_APPROVER_ID=owner@ironwrapexteriors.com
HERMES_ROLE_POLICY_PATH=/srv/ironwrap/hermes/agents/roles.json
HERMES_DRY_RUN_SIGNING_KEY=<unique-at-least-32-byte-host-secret>
HERMES_APPROVAL_PUBLIC_KEY_FILE=/run/secrets/hermes-production-schedule-approval-public.pem
HERMES_APPROVAL_PRIVATE_KEY_FILE=/run/secrets/hermes-production-schedule-approval-private.pem

PRODUCTION_SCHEDULE_BROKER_TENANT_ID=ironwrap
PRODUCTION_SCHEDULE_BROKER_KEY_ID=production-schedule-v1
PRODUCTION_SCHEDULE_BROKER_SHARED_SECRET=<unique-at-least-32-byte-worker-broker-secret>
PRODUCTION_SCHEDULE_BROKER_LISTEN_HOST=127.0.0.1
PRODUCTION_SCHEDULE_BROKER_PORT=8790
PRODUCTION_SCHEDULE_BROKER_MAX_CLOCK_SKEW_MS=60000
PRODUCTION_SCHEDULE_BROKER_MAX_APPROVAL_LIFETIME_MS=300000
