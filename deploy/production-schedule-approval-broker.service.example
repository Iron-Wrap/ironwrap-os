# Private Hermes production-schedule approval broker. Install as
# /etc/systemd/system/ironwrap-production-schedule-approval-broker.service and
# keep the referenced environment file root-readable only. Its isolated process
# and production-controller credential are part of the schedule-write boundary.
[Unit]
Description=IronWrap Hermes production-schedule approval broker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ironwrap-broker
Group=ironwrap-broker
WorkingDirectory=/srv/ironwrap/mcp/erpnext-roofing-mcp
EnvironmentFile=/etc/ironwrap/production-schedule-approval-broker.env
ExecStart=/usr/bin/node /srv/ironwrap/mcp/erpnext-roofing-mcp/src/production-schedule-approval-broker.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/srv/ironwrap /run/secrets
UMask=0077

[Install]
WantedBy=multi-user.target
