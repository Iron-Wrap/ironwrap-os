# Copy to /etc/ironwrap/proposal-publication-approval-broker.env, set owner-only
# permissions, and keep it distinct from every other broker environment.
# The values below are placeholders only; do not reuse any broker secret or
# signing key across authorities.

ERPNEXT_BASE_URL=https://<frappe-origin>
ERPNEXT_TENANT_ID=ironwrap
ERPNEXT_API_KEY=<owner-operator-frappe-api-key>
ERPNEXT_API_SECRET=<owner-operator-frappe-api-secret>
ERPNEXT_REQUEST_TIMEOUT_MS=10000
ERPNEXT_WRITE_ENABLED=true
IRONWRAP_EFFECT_RUNTIME_ENABLED=true
IRONWRAP_EFFECT_RUNTIME_URL=https://<worker-subdomain>.workers.dev
IRONWRAP_EFFECT_RUNTIME_TOKEN=<dedicated-worker-admin-token>

# This broker can invoke exactly dry_run_publish_proposal_evidence_pack and
# request_publish_proposal_evidence_pack under the role policy. Publication is
# the step that makes quote terms customer-visible, so it runs as its own
# owner-operator process and never as lead-concierge or estimator-assistant.
HERMES_AGENT_ROLE=owner-operator
HERMES_ACTOR_USER=owner-operator@ironwrapexteriors.com
HERMES_APPROVER_ID=owner@ironwrapexteriors.com
HERMES_ROLE_POLICY_PATH=/srv/ironwrap/hermes/agents/roles.json
HERMES_DRY_RUN_SIGNING_KEY=<unique-at-least-32-byte-host-secret>
HERMES_APPROVAL_PUBLIC_KEY_FILE=/run/secrets/hermes-approval-public.pem
HERMES_APPROVAL_PRIVATE_KEY_FILE=/run/secrets/hermes-approval-private.pem

PROPOSAL_PUBLICATION_BROKER_TENANT_ID=ironwrap
PROPOSAL_PUBLICATION_BROKER_KEY_ID=proposal-publication-v1
PROPOSAL_PUBLICATION_BROKER_SHARED_SECRET=<unique-at-least-32-byte-worker-broker-secret>
PROPOSAL_PUBLICATION_BROKER_LISTEN_HOST=127.0.0.1
PROPOSAL_PUBLICATION_BROKER_PORT=8790
PROPOSAL_PUBLICATION_BROKER_MAX_CLOCK_SKEW_MS=60000
PROPOSAL_PUBLICATION_BROKER_MAX_APPROVAL_LIFETIME_MS=300000
