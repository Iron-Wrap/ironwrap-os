# Copy to /etc/ironwrap/quote-revision-approval-broker.env, set owner-only
# permissions, and keep it distinct from the lead-triage broker environment.
# The values below are placeholders only; do not reuse either broker secret or
# signing key between the two authorities.

ERPNEXT_BASE_URL=https://<frappe-origin>
ERPNEXT_API_KEY=<estimator-assistant-frappe-api-key>
ERPNEXT_API_SECRET=<estimator-assistant-frappe-api-secret>
ERPNEXT_REQUEST_TIMEOUT_MS=10000
ERPNEXT_WRITE_ENABLED=true
IRONWRAP_EFFECT_RUNTIME_ENABLED=true
IRONWRAP_EFFECT_RUNTIME_URL=https://<worker-subdomain>.workers.dev
IRONWRAP_EFFECT_RUNTIME_TOKEN=<dedicated-worker-admin-token>

# This broker can invoke exactly dry_run_quote_revision and
# request_create_quote_revision under the role policy. It must never run as
# lead-concierge or owner-operator.
HERMES_AGENT_ROLE=estimator-assistant
HERMES_ACTOR_USER=estimator@ironwrapexteriors.com
HERMES_APPROVER_ID=owner@ironwrapexteriors.com
HERMES_ROLE_POLICY_PATH=/srv/ironwrap/hermes/agents/roles.json
HERMES_DRY_RUN_SIGNING_KEY=<unique-at-least-32-byte-host-secret>
HERMES_APPROVAL_PUBLIC_KEY_FILE=/run/secrets/hermes-approval-public.pem
HERMES_APPROVAL_PRIVATE_KEY_FILE=/run/secrets/hermes-approval-private.pem

QUOTE_REVISION_BROKER_TENANT_ID=ironwrap
QUOTE_REVISION_BROKER_KEY_ID=quote-revision-v1
QUOTE_REVISION_BROKER_SHARED_SECRET=<unique-at-least-32-byte-worker-broker-secret>
QUOTE_REVISION_BROKER_LISTEN_HOST=127.0.0.1
QUOTE_REVISION_BROKER_PORT=8789
QUOTE_REVISION_BROKER_MAX_CLOCK_SKEW_MS=60000
QUOTE_REVISION_BROKER_MAX_APPROVAL_LIFETIME_MS=300000
