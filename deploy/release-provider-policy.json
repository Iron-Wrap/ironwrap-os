{
  "schema": "ironwrap_release_provider_policy_v1",
  "account_id": "7ee5775bc1ba46f05c5a65235b60e939",
  "environments": {
    "staging": {
      "credential_secret": "RELEASE_STAGING_CLOUDFLARE_API_TOKEN",
      "worker_name": "ironwrap-bus-staging",
      "workers_dev": true,
      "compatibility_date": "2026-06-28",
      "compatibility_flags": ["nodejs_compat"],
      "observability": { "enabled": true, "head_sampling_rate": 1 },
      "assets": {
        "directory": "../app/dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": [
          "/__scheduled",
          "/admin/*",
          "/api/*",
          "/health",
          "/ingest/*",
          "/public/*",
          "/ready",
          "/webhook/*"
        ]
      },
      "crons": ["*/5 * * * *", "0 14 * * *"],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "ironwrap-bus-staging",
          "database_id": "bd6ab4e9-4095-4df8-906a-bcb18356ddfc",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        { "binding": "RAW", "bucket_name": "ironwrap-bus-staging-raw" }
      ],
      "queue_producers": [
        { "binding": "JN_QUEUE", "queue": "ironwrap-staging-jn-push" },
        {
          "binding": "MEASUREMENT_QUEUE",
          "queue": "ironwrap-staging-measurements"
        },
        {
          "binding": "NEWO_QUEUE",
          "queue": "ironwrap-staging-newo-events"
        }
      ],
      "queue_consumers": [
        {
          "queue": "ironwrap-staging-jn-push",
          "dead_letter_queue": "ironwrap-staging-jn-dlq",
          "max_retries": 5,
          "max_batch_size": 10,
          "max_batch_timeout": 5
        },
        {
          "queue": "ironwrap-staging-jn-dlq",
          "dead_letter_queue": null,
          "max_retries": 1,
          "max_batch_size": null,
          "max_batch_timeout": null
        },
        {
          "queue": "ironwrap-staging-measurements",
          "dead_letter_queue": "ironwrap-staging-measurements-dlq",
          "max_retries": 5,
          "max_batch_size": 1,
          "max_batch_timeout": 1
        },
        {
          "queue": "ironwrap-staging-measurements-dlq",
          "dead_letter_queue": null,
          "max_retries": 1,
          "max_batch_size": null,
          "max_batch_timeout": null
        },
        {
          "queue": "ironwrap-staging-newo-events",
          "dead_letter_queue": "ironwrap-staging-newo-dlq",
          "max_retries": 5,
          "max_batch_size": 10,
          "max_batch_timeout": 5
        },
        {
          "queue": "ironwrap-staging-newo-dlq",
          "dead_letter_queue": null,
          "max_retries": 1,
          "max_batch_size": null,
          "max_batch_timeout": null
        }
      ],
      "routes": []
    },
