{
  "schema": "ironwrap_release_provider_policy_v2",
  "environments": {
    "qa": {
      "account_id": "7ee5775bc1ba46f05c5a65235b60e939",
      "credential_secret": "RELEASE_QA_CLOUDFLARE_API_TOKEN",
      "worker_name": "ironwrap-bus-qa",
      "workers_dev": true,
      "compatibility_date": "2026-06-28",
      "compatibility_flags": ["nodejs_compat"],
      "observability": { "enabled": true, "head_sampling_rate": 1 },
      "assets": {
        "directory": "../app/dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": [
          "/__scheduled",
          "/admin/*",
          "/api/*",
          "/health",
          "/ingest/*",
          "/public/*",
          "/ready",
          "/webhook/*"
        ]
      },
      "crons": ["*/5 * * * *", "0 14 * * *"],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "ironwrap-bus-qa",
          "database_id": "0339cebc-d252-4d67-b78b-58c8b4703c6e",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        { "binding": "RAW", "bucket_name": "ironwrap-bus-qa-raw" },
        { "binding": "PRIVACY_LEDGER", "bucket_name": "ironwrap-bus-qa-privacy" }
      ],
      "queue_producers": [
        { "binding": "JN_QUEUE", "queue": "ironwrap-qa-jn-push" },
        {
          "binding": "MEASUREMENT_QUEUE",
          "queue": "ironwrap-qa-measurements"
        },
        {
          "binding": "NEWO_QUEUE",
          "queue": "ironwrap-qa-newo-events"
        }
      ],
      "queue_consumers": [
        {
          "queue": "ironwrap-qa-jn-push",
          "dead_letter_queue": "ironwrap-qa-jn-dlq",
          "max_retries": 5,
          "max_batch_size": 10,
          "max_batch_timeout": 5
        },
        {
          "queue": "ironwrap-qa-jn-dlq",
          "dead_letter_queue": null,
          "max_retries": 1,
          "max_batch_size": null,
          "max_batch_timeout": null
        },
        {
          "queue": "ironwrap-qa-measurements",
          "dead_letter_queue": "ironwrap-qa-measurements-dlq",
          "max_retries": 5,
          "max_batch_size": 1,
          "max_batch_timeout": 1
        },
        {
          "queue": "ironwrap-qa-measurements-dlq",
          "dead_letter_queue": null,
          "max_retries": 1,
          "max_batch_size": null,
          "max_batch_timeout": null
        },
        {
          "queue": "ironwrap-qa-newo-events",
          "dead_letter_queue": "ironwrap-qa-newo-dlq",
          "max_retries": 5,
          "max_batch_size": 10,
          "max_batch_timeout": 5
        },
        {
          "queue": "ironwrap-qa-newo-dlq",
          "dead_letter_queue": null,
          "max_retries": 1,
          "max_batch_size": null,
          "max_batch_timeout": null
        }
      ],
      "routes": []
    },
    "production": {
      "account_id": "5023dd227b538fc4238439fd7d52640f",
      "credential_secret": "RELEASE_PRODUCTION_CLOUDFLARE_API_TOKEN",
