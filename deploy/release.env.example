# IronWrap OS machine-release credential inventory. These names belong in
# scoped GitHub Actions or external issuer/provider secret stores, never in a
# checked-in filled file or the general Frappe host environment.

# ---- GitHub Actions deploy workflow ----
RELEASE_POLICY_LEDGER_API_TOKEN=<d1-release-ledger-only-token>
RELEASE_STAGING_CLOUDFLARE_API_TOKEN=<staging-worker-d1-r2-queues-only-token>
RELEASE_PRODUCTION_CLOUDFLARE_API_TOKEN=<production-worker-d1-r2-queues-only-token>
RELEASE_INDEPENDENT_ISSUER_URL=<independent-issuer-https-trigger-url-v2-route>
RELEASE_INDEPENDENT_ISSUER_TOKEN=<independent-issuer-trigger-only-token>
RELEASE_REVIEW_PUBLIC_KEY=<independent-review-ed25519-public-key-pem>
RELEASE_PERMIT_PRIVATE_KEY=<release-permit-ed25519-private-key-pem>
RELEASE_PERMIT_PUBLIC_KEY=<release-permit-ed25519-public-key-pem>
RELEASE_STAGING_INGEST_TOKEN=<isolated-staging-ingest-token>
RELEASE_STAGING_ADMIN_TOKEN=<isolated-staging-admin-token>
RELEASE_STAGING_FRAPPE_BASE_URL=<isolated-staging-frappe-https-url>
RELEASE_STAGING_FRAPPE_API_KEY=<isolated-staging-launch-proof-api-key>
RELEASE_STAGING_FRAPPE_API_SECRET=<isolated-staging-launch-proof-api-secret>
RELEASE_PRODUCTION_INGEST_TOKEN=<production-ingest-token>
RELEASE_PRODUCTION_ADMIN_TOKEN=<production-admin-token>
RELEASE_PRODUCTION_FRAPPE_BASE_URL=<production-frappe-https-url>
RELEASE_PRODUCTION_FRAPPE_API_KEY=<production-launch-proof-api-key>
RELEASE_PRODUCTION_FRAPPE_API_SECRET=<production-launch-proof-api-secret>
RELEASE_SERVICE_ADAPTER_URL=<authenticated-frappe-release-adapter-https-url>
RELEASE_SERVICE_ADAPTER_TOKEN=<frappe-release-adapter-bearer-token>
RELEASE_SERVICE_ADAPTER_PUBLIC_KEY=<frappe-release-adapter-ed25519-public-key-pem>
RELEASE_SERVICE_ADAPTER_IDENTITY=<frappe-release-adapter-issuer-identity>
RELEASE_SERVICE_ADAPTER_TASK_ID=<frappe-release-adapter-task-id>
RELEASE_SERVICE_ADAPTER_RUN_ID=<frappe-release-adapter-run-identity>
RELEASE_SERVICE_ADAPTER_KEY_VERSION=<frappe-release-adapter-key-version>

# ---- Independent review and full-surface evidence trigger ----
# The independently permissioned HTTPS v2 trigger accepts an exact candidate
# artifact locator/digest, principal/task/key contract, source/tree/diff, and
# a canonical freshness window. issuer-request creates a five-minute window;
# the trigger accepts at most ten minutes and fails closed after expiry.
# The trigger has no independent findings or provider evidence and does not
# sign or publish receipts. Existing review-sign, review-publish,
# release-evidence-sign, and release-evidence-publish remain the independent
# custodian's separate primitives. Their credentials never enter GitHub,
# Cloudflare, Frappe-adapter, or permit custody.
RELEASE_REVIEW_PRIVATE_KEY=<independent-review-ed25519-private-key-pem>
RELEASE_REVIEW_PUBLISH_TOKEN=<source-addressed-review-ref-write-token>

# ---- Authenticated Frappe release adapter ----
# This provider holds the matching private key and the authority to stage,
# promote, read back, and restore the exact Frappe artifact/revision. It does
# not receive GitHub merge authority or the Cloudflare release token.
RELEASE_SERVICE_ADAPTER_PRIVATE_KEY=<frappe-release-adapter-ed25519-private-key-pem>
