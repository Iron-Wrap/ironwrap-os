{
  "version": "0.2.0",
  "note": "Launch/config manifest for the two MCP servers Hermes connects to. tool_filter arrays are the UNION across roles only for host discovery; the Frappe server itself requires HERMES_AGENT_ROLE plus HERMES_ACTOR_USER, and its Frappe API pair must belong to exactly that actor rather than a shared service principal. It registers only that canonical roles.json allowlist and assignment-scopes Field Companion calls. Frappe approved writes require ERPNEXT_WRITE_ENABLED plus a short-lived server-issued dry_run_receipt and separately signed human approval_receipt; HERMES_DRY_RUN_SIGNING_KEY stays in the MCP host, HERMES_APPROVAL_PUBLIC_KEY_FILE verifies the approval broker's signature, and HERMES_APPROVER_ID binds that key to the approved human identity. The bus retains its separate IRONWRAP_BUS_WRITE_ENABLED + HERMES_WRITE_TOKEN replay gate. Frappe writes record Hermes Run rows; bus replay records envelope-scoped recovery in the bus audit log. env values are placeholders resolved from the Hermes host environment; never commit real secret values.",
  "mcpServers": {
    "ironwrap-bus-mcp": {
      "command": "node",
      "args": ["mcp/ironwrap-bus-mcp/src/server.mjs"],
      "description": "Bus readiness and operating truth plus approved, envelope-scoped dead-letter recovery.",
      "tool_filter": {
        "read": [
          "get_bus_readiness",
          "get_operational_status",
          "list_recent_envelopes",
          "get_envelope",
          "list_dead_letters"
        ],
        "dry_run": [
          "dry_run_replay"
        ],
        "approved_write": [
          "request_replay"
        ]
      },
      "env": {
        "IRONWRAP_BUS_BASE_URL": "${IRONWRAP_BUS_BASE_URL}",
        "IRONWRAP_ADMIN_TOKEN": "${IRONWRAP_ADMIN_TOKEN}",
        "IRONWRAP_BUS_WRITE_ENABLED": "${IRONWRAP_BUS_WRITE_ENABLED}",
        "IRONWRAP_BUS_REQUEST_TIMEOUT_MS": "${IRONWRAP_BUS_REQUEST_TIMEOUT_MS}",
        "HERMES_WRITE_TOKEN": "${HERMES_WRITE_TOKEN}"
      }
    },
    "erpnext-roofing-mcp": {
      "command": "node",
      "args": ["mcp/erpnext-roofing-mcp/src/server.mjs"],
      "description": "IronWrap OS Frappe operating core: read, deterministic policy checks, and review-gated approved writes; legacy server/env names retained for compatibility.",
      "tool_filter": {
        "read": [
          "get_roof_job",
          "get_lead_envelope",
          "list_untriaged_lead_envelopes",
          "list_job_gates",
          "list_blocked_jobs",
          "get_measurement_report",
          "list_measurement_reports_for_job",
          "get_material_takeoff",
          "list_material_takeoffs_for_job",
          "get_supplier_order",
          "list_supplier_orders_for_job",
          "get_supplier_quote",
          "list_supplier_quotes_for_job",
          "get_customer_quote",
          "list_customer_quotes_for_job",
          "get_instant_estimate_session",
          "list_instant_estimate_sessions_for_job",
          "get_evidence_item",
          "list_evidence_for_job",
          "get_field_check_in",
          "list_field_check_ins_for_job",
          "get_proposal_evidence_pack",
          "list_proposal_evidence_packs_for_job",
          "get_payment_milestone",
          "list_payment_milestones_for_job",
          "get_completion_packet",
          "list_completion_packets_for_job",
          "get_warranty_packet",
          "list_warranty_packets_for_job",
          "get_review_request",
          "list_review_requests_for_job",
          "get_communication_event",
          "list_communication_events_for_job",
          "list_communication_events_for_lead",
          "get_price_book_rule",
          "list_price_book_rules",
          "get_visual_property_model",
          "list_visual_property_models_for_job",
          "get_roof_area",
          "list_roof_areas_for_job",
          "get_option_package",
          "list_option_packages_for_job",
          "get_scope_clause",
          "list_scope_clauses_for_job",
          "get_crew_profile",
          "list_crew_profiles",
          "get_job_assignment",
          "list_job_assignments_for_job",
          "get_change_order",
          "list_change_orders_for_job",
          "get_safety_plan",
          "list_safety_plans_for_job",
          "get_job_compliance_record",
          "list_job_compliance_records_for_job",
          "get_communication_consent",
          "list_communication_consents_for_job",
          "get_customer_decision",
          "list_customer_decisions_for_job",
          "get_contract_acceptance",
          "list_contract_acceptances_for_job",
          "get_integration_reconciliation",
          "list_integration_reconciliations_for_job",
          "get_tenant_export_run",
          "list_tenant_export_runs_for_tenant",
          "get_automation_incident",
          "list_automation_incidents",
          "get_white_label_tenant",
          "list_white_label_tenants",
          "list_market_watch_items",
          "check_consent",
          "check_quiet_hours",
          "get_hermes_run",
          "list_hermes_runs_for_job"
        ],
        "dry_run": [
          "dry_run_update_gate",
          "dry_run_material_takeoff",
          "dry_run_update_material_takeoff_status",
          "dry_run_supplier_order",
          "dry_run_supplier_quote",
          "dry_run_quote_revision",
          "dry_run_bind_quote_price_rules",
          "dry_run_proposal_evidence_pack",
          "dry_run_job_assignment",
          "dry_run_change_order",
          "dry_run_change_order_transition",
          "dry_run_safety_plan",
          "dry_run_safety_acknowledgement",
          "dry_run_job_compliance_record",
          "dry_run_customer_decision",
          "dry_run_communication_consent",
          "dry_run_reconciliation_resolution",
          "dry_run_tenant_export",
          "dry_run_completion_packet",
          "dry_run_warranty_packet",
          "dry_run_review_request",
          "dry_run_communication_event",
          "dry_run_mark_lead_triaged",
          "dry_run_market_watch_item"
        ],
        "approved_write": [
          "request_update_gate",
          "request_create_material_takeoff",
          "request_update_material_takeoff_status",
          "request_create_supplier_order",
          "request_create_supplier_quote",
          "request_create_quote_revision",
          "request_bind_quote_price_rules",
          "request_create_proposal_evidence_pack",
          "request_create_job_assignment",
          "request_create_change_order",
          "request_transition_change_order",
          "request_create_safety_plan",
          "request_record_safety_acknowledgement",
          "request_record_job_compliance",
          "request_record_customer_decision",
          "request_record_communication_consent",
          "request_resolve_reconciliation",
          "request_tenant_export",
          "request_create_completion_packet",
          "request_create_warranty_packet",
          "request_create_review_request",
          "request_record_communication_event",
          "request_mark_lead_triaged",
          "request_add_market_watch_item"
        ]
      },
      "env": {
        "ERPNEXT_BASE_URL": "${ERPNEXT_BASE_URL}",
        "ERPNEXT_API_KEY": "${ERPNEXT_API_KEY}",
        "ERPNEXT_API_SECRET": "${ERPNEXT_API_SECRET}",
        "ERPNEXT_WRITE_ENABLED": "${ERPNEXT_WRITE_ENABLED}",
        "ERPNEXT_REQUEST_TIMEOUT_MS": "${ERPNEXT_REQUEST_TIMEOUT_MS}",
        "HERMES_AGENT_ROLE": "${HERMES_AGENT_ROLE}",
        "HERMES_ACTOR_USER": "${HERMES_ACTOR_USER}",
        "HERMES_APPROVER_ID": "${HERMES_APPROVER_ID}",
        "HERMES_ROLE_POLICY_PATH": "${HERMES_ROLE_POLICY_PATH}",
        "HERMES_DRY_RUN_SIGNING_KEY": "${HERMES_DRY_RUN_SIGNING_KEY}",
        "HERMES_APPROVAL_PUBLIC_KEY_FILE": "${HERMES_APPROVAL_PUBLIC_KEY_FILE}"
      }
    }
  }
}
