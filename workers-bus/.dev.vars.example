# Copy to `.dev.vars` for local `wrangler dev`. NEVER commit real secrets (.dev.vars is gitignored).
# In production set these with: wrangler secret put <NAME>  (or ../scripts/apply-secrets.sh)

INGEST_TOKEN="dev-ingest-token-change-me"
ADMIN_TOKEN="dev-admin-token-change-me"
APP_AUTH_PEPPER="replace-with-at-least-32-random-characters"

# Newo credentials stay in Worker secrets. Use separate webhook and booking authorities.
NEWO_WEBHOOK_TOKEN=""
NEWO_BOOKING_TOKEN=""
NEWO_API_KEY=""

# JobNimbus (api1 Bearer key)
JOBNIMBUS_API_KEY=""

# Google Workspace service account (single-line JSON) — Gmail send + Drive job folders,
# impersonating FROM_EMAIL via domain-wide delegation.
GOOGLE_SERVICE_ACCOUNT_JSON=""

# QuickBooks webhook verifier token (Intuit)
QB_WEBHOOK_TOKEN=""

# Loopback Intuit double for the local money-plane stack (IRO-52). Honoured ONLY when
# APP_ALLOW_INSECURE_LOCAL="true" and the origin is loopback; wrangler.jsonc sets that var to
# "false" in every deployed environment, so a deployed Worker always resolves to Intuit. This is
# what lets the accounting dispatcher be exercised end to end locally without a live provider call.
# QB_API_BASE_LOCAL_OVERRIDE="http://127.0.0.1:19099"

# Anthropic key for measurement-report OCR. Required whenever MEASUREMENT_OCR_ENABLED is
# "true" — which wrangler.jsonc sets in every environment, including local — otherwise
# `/ready` reports measurement_ocr_configuration false on a fresh checkout.
MEASUREMENT_OCR_API_KEY=""

# ERPNext/Frappe API token pair (optional; only used when ERPNEXT_ENABLED=true)
ERPNEXT_API_KEY=""
ERPNEXT_API_SECRET=""

# Internal authority executor rail. The MCP host holds the matching secret;
# browser/PWA sessions cannot claim terminal outcomes or issuer readbacks.
AUTHORITY_RECORD_EXECUTOR_HMAC_KEY="replace-with-a-separate-32-byte-secret"

# Dedicated customer-contract acceptance channel. These credentials must belong to the
# `IronWrap Customer Acceptance Service` role, never the broad Worker BFF identity.
APP_CUSTOMER_ACCEPTANCE_HMAC_KEY="replace-with-a-separate-32-byte-secret"
APP_CUSTOMER_ACCEPTANCE_FRAPPE_API_KEY=""
APP_CUSTOMER_ACCEPTANCE_FRAPPE_API_SECRET=""

# Dedicated Facet-to-IronWrap event authority; never reuse INGEST_TOKEN or ERP credentials.
FACET_DESIGN_INGEST_HMAC_KEY="replace-with-a-separate-32-byte-secret"
# Exact Facet source tenant -> local IronWrap tenant allowlist; required before enabling ingress.
FACET_DESIGN_INGEST_TENANT_MAP_JSON='{"facet-production":"ironwrap"}'

# Dedicated Worker-to-Frappe Facet evidence projection. These must belong to the
# `IronWrap Facet Design Projection Service` role and never reuse the Facet ingress HMAC,
# broad ERP token, or customer-contract service identity.
FACET_DESIGN_FRAPPE_PROJECTION_HMAC_KEY="replace-with-a-different-32-byte-secret"
FACET_DESIGN_FRAPPE_PROJECTION_FRAPPE_API_KEY=""
FACET_DESIGN_FRAPPE_PROJECTION_FRAPPE_API_SECRET=""
# Deployment-controlled opaque exact-anchor mappings only; no names, addresses, prices, or user input.
FACET_DESIGN_FRAPPE_PROJECTION_ASSOCIATIONS_JSON='{"schema_version":1,"associations":[]}'

# Signed Facet v2 chain (the live rail; the FACET_DESIGN_INGEST_* pair above is the
# retired v1 contract). `npm run dev` generates all three of these into
# deploy/local/keys/ and writes them here, so a local stack needs no manual step.
#
# FACET_LAUNCH_HMAC_KEY signs the owner's "open in Facet" capability. It must be
# base64url of at least 32 bytes and is paired with the non-secret
# APP_FACET_LAUNCH_BASE_URL / APP_FACET_LAUNCH_SOURCE_TENANT_ID in wrangler.jsonc.
FACET_LAUNCH_HMAC_KEY=""
# FACET_V2_KEYS_JSON holds the delivery-verification keys Facet signs its customer-decision
# event with. Every entry needs a >=32-character secret and an active validity window; the
# matching route lives in the non-secret FACET_V2_ROUTES_JSON.
# FACET_V2_KEYS_JSON='[{"key_id":"facet-prod","key_version":1,"secret":"...","not_before_ms":0,"not_after_ms":4102444800000}]'

# Public instant estimate (disabled until the non-secret vars in wrangler.jsonc
# are configured with exact origins, rate limits, and a validated JSON rule set).
PUBLIC_ESTIMATE_TURNSTILE_SECRET=""
PUBLIC_ESTIMATE_RATE_LIMIT_PEPPER="replace-with-at-least-32-random-characters"

# Local overrides of wrangler.jsonc vars (optional):
# JOBNIMBUS_ENABLED="false"
# NEWO_ENABLED="false"
# NEWO_BOOKING_MODE="request_only"
# NEWO_CONTROL_WRITE_ENABLED="false"
# NEWO_OUTBOUND_ENABLED="false"
# ERPNEXT_ENABLED="false"
# ERPNEXT_BASE_URL="https://your-site.frappe.cloud"
# APP_BFF_ENABLED="true"
# APP_HERMES_DESKTOP_ENABLED="false"
# APP_PUBLIC_ORIGIN="http://localhost:5173"
# APP_ALLOWED_ORIGINS="http://localhost:5173"
# APP_ALLOW_INSECURE_LOCAL="true"
# APP_CUSTOMER_CONTRACT_ACCEPTANCE_ENABLED="false"
# FACET_DESIGN_INGEST_ENABLED="false"
# FACET_DESIGN_FRAPPE_PROJECTION_ENABLED="false"
# APP_INSURANCE_ESTIMATOR_FRAPPE_USERS="estimator@your-site.example"
# PUBLIC_ESTIMATE_ENABLED="true"
# PUBLIC_ESTIMATE_ALLOWED_ORIGINS="http://localhost:5173"
# PUBLIC_ESTIMATE_ALLOWED_BRANDS="ironwrap,iroof"
# PUBLIC_ESTIMATE_CONSENT_JURISDICTION="Alberta, Canada"
# PUBLIC_ESTIMATE_ALLOW_INSECURE_LOCAL="true"
# PUBLIC_ESTIMATE_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
# PUBLIC_ESTIMATE_RATE_LIMIT_WINDOW_SECONDS="900"
# PUBLIC_ESTIMATE_RATE_LIMIT_IP_MAX="12"
# PUBLIC_ESTIMATE_RATE_LIMIT_CLIENT_MAX="3"
# PUBLIC_ESTIMATE_RANGE_RULES_JSON='[]' # Use allowed tenant brand/service ids only; owner-approved/versioned.
