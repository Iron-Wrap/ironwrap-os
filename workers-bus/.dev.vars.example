# Copy to `.dev.vars` for local `wrangler dev`. NEVER commit real secrets (.dev.vars is gitignored).
# In production set these with: wrangler secret put <NAME>  (or ../scripts/apply-secrets.sh)

INGEST_TOKEN="dev-ingest-token-change-me"
ADMIN_TOKEN="dev-admin-token-change-me"

# JobNimbus (api1 Bearer key)
JOBNIMBUS_API_KEY=""

# Google Workspace service account (single-line JSON) — Gmail send + Drive job folders,
# impersonating FROM_EMAIL via domain-wide delegation.
GOOGLE_SERVICE_ACCOUNT_JSON=""

# QuickBooks webhook verifier token (Intuit)
QB_WEBHOOK_TOKEN=""

# Local overrides of wrangler.jsonc vars (optional):
# JOBNIMBUS_ENABLED="false"
