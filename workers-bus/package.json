{
  "name": "ironwrap-bus",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "test": "node --test",
    "typecheck": "tsc --noEmit",
    "typegen": "wrangler types",
    "dev": "node ../deploy/local/predev.mjs && wrangler dev --env local --port ${IRONWRAP_LOCAL_WORKER_PORT:-7100} --test-scheduled",
    "deploy": "wrangler deploy --env=\"\"",
    "deploy:staging": "wrangler deploy --env staging",
    "db:migrate:local": "wrangler d1 migrations apply ironwrap-bus --local",
    "db:migrate": "wrangler d1 migrations apply ironwrap-bus --remote --env=\"\"",
    "db:migrate:staging": "wrangler d1 migrations apply DB --remote --env staging"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "wrangler": "4.123.0"
  }
}
