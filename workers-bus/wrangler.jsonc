          "QB_API_MINOR_VERSION": "75",
          "QB_API_TIMEOUT_MS": "10000",
          "QB_TOKEN_ENCRYPTION_KEY_VERSION": ""
        },
        "CFG_FACET": {
          "FACET_DESIGN_INGEST_ENABLED": "false",
          "FACET_DESIGN_INGEST_TENANT_MAP_JSON": "{}",
          "FACET_V2_INGEST_ENABLED": "true",
          "FACET_V2_ROUTES_JSON": "[]",
          "FACET_V2_NATIVE_PROJECTION_ENABLED": "true",
          "FACET_DESIGN_FRAPPE_PROJECTION_ENABLED": "false"
        },
        "CFG_JN": {
          "JN_CONTACT_RECORD_TYPE": "Customer",
          "JN_CONTACT_STATUS": "New",
          "JN_JOB_RECORD_TYPE": "Retail",
          "JN_JOB_STATUS": "Lead"
        },
        "CFG_ERPNEXT": {
          "ERPNEXT_ENABLED": "false",
          "ERPNEXT_BASE_URL": "",
          "ERPNEXT_LEAD_ENVELOPE_DOCTYPE": "Lead Envelope",
          "ERPNEXT_INTEGRATION_USER": ""
        },
        "CFG_SHARED": {
          "SHARED_DRIVE_ID_JOBS": "",
          "SHARED_DRIVE_ID_RESTRICTED": "",
          "SHARED_DRIVE_ID_ARCHIVE": ""
        },
        "CFG_MEASUREMENT": {
          // OCR is off in qa (owner decision 2026-09-29, taken to the team), unlike the production
          // top level. MEASUREMENT_OCR_API_KEY then carries no required value, but it stays in the
          // secret-name inventory the release preflight demands on the qa Worker.
          "MEASUREMENT_OCR_ENABLED": "false",
          "MEASUREMENT_OCR_MODEL": "claude-opus-5-5"
        },
        "CFG_CORE": {
          // qa sends real mail since 2026-10-02, so it never uses the business mailboxes: the
          // sender and both recipients are the operator's own (owner decision, 2026-10-02).
          "OWNER_ALERT_EMAIL": "sergeyap@mindburn.org",
          "BACKUP_ALERT_EMAIL": "sergeyap@mindburn.org",
          "FROM_EMAIL": "sergeyap@mindburn.org",
          "EFFECT_RUNTIME_ENABLED": "true",
          // Stage automations mail the tenant's automation recipients. Keep this off until qa's
          // recipients (Settings, Automations, Recipients) name only test mailboxes; before the
          // first recipient record exists, the legacy PIPELINE_AUTOMATION_RECIPIENTS_JSON secret
          // is the fallback, and its qa value is not known to be test-only.
          "PIPELINE_AUTOMATION_ENABLED": "false",
          "JOBNIMBUS_ENABLED": "false",
          "OMNIROUTE_URL": "",
          "OPERATING_AUTOMATION_USER": "ironwrap-worker",
          // qa prices nothing yet: pricing comes only from a reviewed D1 catalog activation, and
          // APP_PRICING_CATALOG_ENABLED stays off in qa until the catalog cutover is accepted.
          // Proposal documents need Google Drive, and the qa Google key only sends mail.
          "ESTIMATOR_PRICE_LIST_JSON": "",
          "PROPOSAL_TEMPLATE_DOC_ID": "",
          "DEDUP_WINDOW_HOURS": "72",
          "STUCK_THRESHOLD_MIN": "15",
          // SYNTHETIC QA commercial authority policy (owner-approved QA path, native-first): it opens
          // the D1 commercial routes for synthetic synth-seed records only. Every limit is synthetic:
          // a 365-day validity window, quotes up to
          // 10000000 cents, owner and worker (staff) actors, never agents. production and local
          // carry "" and keep the commercial write path closed. When the window lapses the QA seed
          // stops with policy_expired; renewal is that event's one-line edit of valid_from/valid_until.
          "COMMERCIAL_AUTHORITY_POLICY_JSON": "{\"schema_version\":\"ironwrap.commercial-authority-policy.v1\",\"policy_id\":\"qa-synthetic-commercial-policy\",\"policy_version\":\"v1\",\"tenant_id\":\"ironwrap\",\"status\":\"active\",\"valid_from\":\"2026-10-18T19:00:00.000Z\",\"valid_until\":\"2027-10-18T19:00:00.000Z\",\"max_fact_age_seconds\":600,\"max_permit_lifetime_seconds\":300,\"allowed_actions\":[\"lead.triage.record\",\"quote.revision.record\",\"proposal.revision.record\",\"proposal.publish\",\"proposal.withdraw\"],\"allowed_actor_types\":[\"owner\",\"worker\"],\"max_quote_total_cents\":10000000}"
        },
        "CFG_AGENT": {
          // qa holds synthetic data only, and the QA agent host runs as a synthetic host
          // (AGENT_HOST_DATA_CLASS=synthetic), so its synthetic runs close here.
          "AGENT_DATA_CLASS": "synthetic",
          // The inbound producer is on in qa: envelopes recorded from this instant on become AI
          // team signals; earlier ones never do.
          "AGENT_INBOUND_FROM": "2026-10-20T15:52:43Z"
        }
      }
    }
  }
}
