    "staging": {
      "workers_dev": true,
      "routes": [],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "ironwrap-bus-staging",
          "database_id": "bd6ab4e9-4095-4df8-906a-bcb18356ddfc",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        { "binding": "RAW", "bucket_name": "ironwrap-bus-staging-raw" }
      ],
      "queues": {
        "producers": [
          { "binding": "JN_QUEUE", "queue": "ironwrap-staging-jn-push" },
          { "binding": "MEASUREMENT_QUEUE", "queue": "ironwrap-staging-measurements" },
          { "binding": "NEWO_QUEUE", "queue": "ironwrap-staging-newo-events" }
        ],
        "consumers": [
          {
            "queue": "ironwrap-staging-jn-push",
            "max_retries": 5,
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "dead_letter_queue": "ironwrap-staging-jn-dlq"
          },
          { "queue": "ironwrap-staging-jn-dlq", "max_retries": 1 },
          {
            "queue": "ironwrap-staging-measurements",
            "max_retries": 5,
            "max_batch_size": 1,
            "max_batch_timeout": 1,
            "dead_letter_queue": "ironwrap-staging-measurements-dlq"
          },
          { "queue": "ironwrap-staging-measurements-dlq", "max_retries": 1 },
          {
            "queue": "ironwrap-staging-newo-events",
            "max_retries": 5,
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "dead_letter_queue": "ironwrap-staging-newo-dlq"
          },
          { "queue": "ironwrap-staging-newo-dlq", "max_retries": 1 }
        ]
      },
      "triggers": { "crons": ["*/5 * * * *", "0 14 * * *"] },
