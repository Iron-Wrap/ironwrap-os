    // qa: the Cloudflare QA environment that follows origin/main (IRO-255, IRO-259, IRO-260).
    // Resources created 2026-09-29 in account 7ee5775b...: D1 ironwrap-bus-qa (WNAM),
    // R2 ironwrap-bus-qa-raw, six ironwrap-qa-* queues. This is the only environment a push
    // to main deploys; production is a separate tag-triggered release (IRO-264).
    "qa": {
      // qa answers on its own subdomain and keeps the workers.dev address working too. Merge only
      // after ironwrapexteriors.com is an active zone in this Cloudflare account and the qa deploy
      // token holds Zone Read, DNS Edit and Workers Routes Edit on it: `wrangler triggers deploy`
      // attaches the domain, and it fails the qa deploy while the zone is still at GoDaddy.
      // workers_dev must stay explicit, because a route turns it off by default.
      "workers_dev": true,
      "routes": [{ "pattern": "qa.ironwrapexteriors.com", "custom_domain": true }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "ironwrap-bus-qa",
          "database_id": "0339cebc-d252-4d67-b78b-58c8b4703c6e",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        { "binding": "RAW", "bucket_name": "ironwrap-bus-qa-raw" },
        { "binding": "PRIVACY_LEDGER", "bucket_name": "ironwrap-bus-qa-privacy" }
      ],
      "queues": {
        "producers": [
          { "binding": "JN_QUEUE", "queue": "ironwrap-qa-jn-push" },
          { "binding": "MEASUREMENT_QUEUE", "queue": "ironwrap-qa-measurements" },
          { "binding": "NEWO_QUEUE", "queue": "ironwrap-qa-newo-events" }
        ],
        "consumers": [
          {
            "queue": "ironwrap-qa-jn-push",
            "max_retries": 5,
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "dead_letter_queue": "ironwrap-qa-jn-dlq"
          },
          { "queue": "ironwrap-qa-jn-dlq", "max_retries": 1 },
          {
            "queue": "ironwrap-qa-measurements",
            "max_retries": 5,
            "max_batch_size": 1,
            "max_batch_timeout": 1,
            "dead_letter_queue": "ironwrap-qa-measurements-dlq"
          },
          { "queue": "ironwrap-qa-measurements-dlq", "max_retries": 1 },
          {
            "queue": "ironwrap-qa-newo-events",
            "max_retries": 5,
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "dead_letter_queue": "ironwrap-qa-newo-dlq"
          },
          { "queue": "ironwrap-qa-newo-dlq", "max_retries": 1 }
        ]
      },
      "triggers": { "crons": ["*/5 * * * *", "0 14 * * *"] },
      "vars": {
        // qa exists so the owner can try every merged feature on synthetic data. A feature is on
        // here when it has no outside effect for real customers or suppliers: document
        // generation and evidence uploads write only qa R2/D1, readiness admission writes only
        // qa D1, and the customer page family (portal, contract acceptance, material decision)
        // mails only the customer address on the qa record, which is synthetic or a tester's
        // own. Still off here, each for a missing dependency: Hermes desktop (needs the desktop
        // client), proposal publication and the four approval brokers (the brokers run through
        // Frappe, which is being retired), Facet quote-revision prepare and Facet design ingest
        // (no consumer in the Worker).
        "CFG_APP": {
          "APP_DOCUMENT_GENERATION_ENABLED": "true",
          "APP_PRICING_CATALOG_ENABLED": "false",
          "APP_BFF_ENABLED": "true",
          "APP_READINESS_ADMISSION_ENABLED": "true",
          "APP_EVIDENCE_UPLOADS_ENABLED": "true",
          "APP_HERMES_DESKTOP_ENABLED": "false",
          "APP_CUSTOMER_PORTAL_ENABLED": "true",
          "APP_CUSTOMER_CONTRACT_ACCEPTANCE_ENABLED": "true",
          "APP_CUSTOMER_PORTAL_DECISION_ENABLED": "true",
          "APP_FACET_QUOTE_REVISION_PREPARE_ENABLED": "false",
          "APP_PROPOSAL_PUBLICATION_ENABLED": "false",
          "APP_FACET_LAUNCH_ENABLED": "true",
          "APP_FACET_LAUNCH_BASE_URL": "",
          "APP_FACET_LAUNCH_SOURCE_TENANT_ID": "",
          "APP_TENANT_ID": "ironwrap",
          "APP_TENANT_NAME": "IronWrap OS — QA",
          "APP_TENANT_BRAND": "IronWrap",
          "APP_LOCALE": "en-CA",
          "APP_TIME_ZONE": "America/Edmonton",
          "APP_CURRENCY": "CAD",
          // Sign-in, invite, crew pairing and customer links are built from APP_PUBLIC_ORIGIN.
          // The workers.dev origin stays allowed so links already sent there still work.
          "APP_PUBLIC_ORIGIN": "https://qa.ironwrapexteriors.com",
          "APP_ALLOWED_ORIGINS": "https://qa.ironwrapexteriors.com,https://ironwrap-bus-qa.yellow-rain-7498.workers.dev",
          "APP_ALLOW_INSECURE_LOCAL": "false",
          "APP_FIRST_OWNER_BOOTSTRAP_ENABLED": "true",
          "APP_FRAPPE_REQUEST_TIMEOUT_MS": "8000",
          "APP_INSURANCE_ESTIMATOR_FRAPPE_USERS": "",
          "APP_VISUAL_PREVIEW_ALLOWED_ORIGINS": "",
          "APP_APPROVAL_BROKER_URL": "",
