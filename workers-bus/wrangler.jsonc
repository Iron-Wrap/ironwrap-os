{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ironwrap-bus",
  "account_id": "7ee5775bc1ba46f05c5a65235b60e939",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-28",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "workers_dev": false,
  "routes": [
    { "pattern": "ironwrap-bus.ironwrapexteriors.com", "custom_domain": true }
  ],

  // One deployment boundary: the Worker serves the built PWA and runs every dynamic/auth route.
  // CI builds ../app/dist before Worker bundle validation or deployment.
  "assets": {
    "directory": "../app/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/health",
      "/ready",
      "/admin/*",
      "/ingest/*",
      "/public/*",
      "/webhook/*",
      "/__scheduled"
    ]
  },

  // Owned system of record. Create with: wrangler d1 create ironwrap-bus → paste database_id.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ironwrap-bus",
      "database_id": "f0674848-13df-4422-9896-8ba2719663b8",
      "migrations_dir": "migrations"
    }
  ],

  // Raw inbound bodies (stored FIRST, before any processing). wrangler r2 bucket create ironwrap-bus-raw
  "r2_buckets": [
    { "binding": "RAW", "bucket_name": "ironwrap-bus-raw" }
  ],

  // JobNimbus bridge plus the independently retried Newo-to-owned-core pipeline. Create with:
  //   wrangler queues create ironwrap-jn-push
  //   wrangler queues create ironwrap-jn-dlq
  //   wrangler queues create ironwrap-measurements
  //   wrangler queues create ironwrap-measurements-dlq
  //   wrangler queues create ironwrap-newo-events
  //   wrangler queues create ironwrap-newo-dlq
  "queues": {
    "producers": [
      { "binding": "JN_QUEUE", "queue": "ironwrap-jn-push" },
      { "binding": "MEASUREMENT_QUEUE", "queue": "ironwrap-measurements" },
      { "binding": "NEWO_QUEUE", "queue": "ironwrap-newo-events" }
    ],
    "consumers": [
      {
        "queue": "ironwrap-jn-push",
        "max_retries": 5,
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "dead_letter_queue": "ironwrap-jn-dlq"
      },
      { "queue": "ironwrap-jn-dlq", "max_retries": 1 },
      {
        "queue": "ironwrap-measurements",
        "max_retries": 5,
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "dead_letter_queue": "ironwrap-measurements-dlq"
      },
      { "queue": "ironwrap-measurements-dlq", "max_retries": 1 },
      {
        "queue": "ironwrap-newo-events",
        "max_retries": 5,
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "dead_letter_queue": "ironwrap-newo-dlq"
      },
      { "queue": "ironwrap-newo-dlq", "max_retries": 1 }
    ]
  },

  // */5 = retry sweep (re-drive stuck pushes); 0 14 * * * = daily reconciliation digest/heartbeat.
  "triggers": { "crons": ["*/5 * * * *", "0 14 * * *"] },

  // Non-secret config. Secrets go only via `wrangler secret put`:
  //   INGEST_TOKEN, ADMIN_TOKEN, EFFECT_RUNTIME_TOKEN, NEWO_WEBHOOK_TOKEN, NEWO_API_KEY, NEWO_BOOKING_TOKEN,
  //   NEWO_CONTROL_SIGNING_SECRET,
  //   JOBNIMBUS_API_KEY, GOOGLE_SERVICE_ACCOUNT_JSON,
  //   PIPELINE_AUTOMATION_RECIPIENTS_JSON (LEGACY, optional: automation recipients are tenant
  //     data since ELEC-204; this blob is only a fallback for a tenant that has never written
  //     a recipient record, and is not required by a new deployment),
  //   MEASUREMENT_OCR_API_KEY,
  //   optional OMNIROUTE_API_KEY (credit-exhausted LLM fallback; not required by release preflight),
  //   QB_WEBHOOK_TOKEN, QB_CLIENT_ID, QB_CLIENT_SECRET, QB_TOKEN_ENCRYPTION_KEY,
  //   QB_FINAL_INVOICE_FRAPPE_API_KEY, QB_FINAL_INVOICE_FRAPPE_API_SECRET,
  //   QB_RECONCILIATION_ISSUER_API_KEY,
  //   QB_RECONCILIATION_ISSUER_API_SECRET, ERPNEXT_API_KEY, ERPNEXT_API_SECRET, APP_AUTH_PEPPER,
  //   FLEET_CAPTURE_FRAPPE_API_KEY, FLEET_CAPTURE_FRAPPE_API_SECRET,
  //   WORK_PACKAGE_FRAPPE_API_KEY, WORK_PACKAGE_FRAPPE_API_SECRET,
  //   APP_CUSTOMER_ACCEPTANCE_HMAC_KEY, APP_CUSTOMER_ACCEPTANCE_FRAPPE_API_KEY,
  //   APP_CUSTOMER_ACCEPTANCE_FRAPPE_API_SECRET,
  //   FACET_DESIGN_INGEST_HMAC_KEY, FACET_V2_KEYS_JSON, POSTIZ_API_KEY,
  //   FACET_DESIGN_FRAPPE_PROJECTION_HMAC_KEY,
  //   FACET_DESIGN_FRAPPE_PROJECTION_FRAPPE_API_KEY,
  //   FACET_DESIGN_FRAPPE_PROJECTION_FRAPPE_API_SECRET,
  //   PUBLIC_ESTIMATE_TURNSTILE_SECRET, PUBLIC_ESTIMATE_RATE_LIMIT_PEPPER,
  //   APPROVAL_BROKER_SHARED_SECRET, QUOTE_REVISION_BROKER_SHARED_SECRET,
  //   PROPOSAL_PUBLICATION_BROKER_SHARED_SECRET,
  //   PRODUCTION_SCHEDULE_BROKER_SHARED_SECRET, AUTHORITY_RECORD_EXECUTOR_HMAC_KEY.
  //   Broker and authority-executor secrets
  //   are Worker-to-private-broker only; never expose either through the PWA or a public
  //   environment variable.
  // Email/Drive = Google Workspace via service account + domain-wide delegation (live-verified
  // 2026-07-02). FROM_EMAIL is the impersonated sender: sales@ for now — switch to quote@ once
  // that mailbox migrates onto the Google Workspace. SMS is JobNimbus Engage's job (no Twilio send).
  "vars": {
    "OWNER_ALERT_EMAIL": "info@ironwrapexteriors.com",
    "BACKUP_ALERT_EMAIL": "sales@ironwrapexteriors.com",
    "FROM_EMAIL": "sales@ironwrapexteriors.com",
    "EFFECT_RUNTIME_ENABLED": "true",
    "APP_DOCUMENT_GENERATION_ENABLED": "false",
    "PIPELINE_AUTOMATION_ENABLED": "false",
    "JOBNIMBUS_ENABLED": "true",
    "MEASUREMENT_OCR_ENABLED": "true",
    "MEASUREMENT_OCR_MODEL": "claude-opus-5",
    "OMNIROUTE_URL": "",
    "NEWO_PRODUCTION_REQUIRED": "false",
    "NEWO_ENABLED": "false",
    "NEWO_CONTROL_WRITE_ENABLED": "false",
    "NEWO_BOOKING_MODE": "request_only",
    "NEWO_OUTBOUND_ENABLED": "false",
    "NEWO_API_BASE_URL": "https://api.newo.ai",
    "NEWO_PROJECT_ID": "",
    "NEWO_AGENT_ID": "",
    "NEWO_REPORT_WEBHOOK_ID": "",
    "NEWO_REPORT_WEBHOOK_URL": "",
    "NEWO_HANDOFF_WEBHOOK_ID": "",
    "NEWO_HANDOFF_WEBHOOK_URL": "",
    "NEWO_PROTECTED_WEBHOOK_IDS": "",
    "NEWO_EXPECTED_CONFIG_VERSION": "newo.production.v1",
    "NEWO_TOOL_SCHEMA_SHA256": "6d1028836d51f25a42cf0b38660ccf5d7f624f5396616ebd2c5168b16a1554fa",
    "NEWO_REPORT_SCHEMA_SHA256": "5c587d4c53b872fbef4290a315ecc7e00477371168b1ac4a07735fff695602cb",
    "NEWO_KB_VERSION": "ironwrap-receptionist.v1",
    "NEWO_KB_SHA256": "9549fdf4956053b84e261f4909e31a8b072599cd2dcae7aa85861d4592a9aa64",
    "NEWO_PHONE_NUMBER": "",
    "NEWO_ENABLED_CHANNELS": "voice",
    "NEWO_TRANSFER_POLICY": "owner_then_voicemail",
    "NEWO_OWNER_TRANSFER_NUMBER": "",
    "NEWO_R2_LIFECYCLE_PROVEN": "false",
    "NEWO_USAGE_LIMIT_MINUTES": "",
    "NEWO_USAGE_ALERT_PERCENT": "80",
    "NEWO_JOBNIMBUS_BOOKING_PROVEN": "false",
    "NEWO_CALLBACK_OWNER_USER": "",
    "NEWO_BOOKING_HORIZON_DAYS": "30",
    "NEWO_REPORT_TIMEOUT_MINUTES": "30",
    "NEWO_SYNC_RETRY_MINUTES": "5",
    "NEWO_API_TIMEOUT_MS": "10000",
    "NEWO_CONTROL_RECEIPT_TTL_SECONDS": "600",
    "JN_CONTACT_RECORD_TYPE": "Customer",
    "JN_CONTACT_STATUS": "New",
    "JN_JOB_RECORD_TYPE": "Retail",
    "JN_JOB_STATUS": "Lead",
    // Frappe operating core. ERPNEXT_BASE_URL must resolve BEFORE this is deployed:
    // with the flag on and the host unreachable, /ready goes red (fail-closed) and every
    // lead push retries into the dead-letter queue.
    //
    // It has not resolved since the flag was turned on: os.ironwrapexteriors.com has no
    // DNS record of any kind, and all three brand domains sit on GoDaddy nameservers whose
    // control was never part of the ownership handover. That is why /ready has been red.
    //
    // ironwrap.mindburn.org is a real host reached through a Cloudflare Tunnel with no
    // inbound port open: netcup VPS in Manassas running the pinned frappe_docker topology,
    // seven app processes on one digest-pinned image. The hostname sits in the neighbouring
    // estate's zone by a decision taken on 2026-08-19, because IronWrap has no Cloudflare
    // zone of its own until DNS authority is obtained. Move it to os.ironwrapexteriors.com
    // once that happens; nothing else here changes.
    "ERPNEXT_ENABLED": "true",
    "ERPNEXT_BASE_URL": "https://ironwrap.mindburn.org",
    "QB_EXPECTED_REALM_ID": "",
    "QB_RECONCILIATION_ISSUER_USER": "",
    "QB_OAUTH_ENABLED": "false",
    "QB_FINAL_INVOICE_ENABLED": "false",
    "QB_API_ENVIRONMENT": "production",
    "QB_API_MINOR_VERSION": "75",
    "QB_API_TIMEOUT_MS": "10000",
    "QB_TOKEN_ENCRYPTION_KEY_VERSION": "",
    "ERPNEXT_LEAD_ENVELOPE_DOCTYPE": "Lead Envelope",
    // Out of scope for the lead path: only the public-estimator consent mirror requires it,
    // and PUBLIC_ESTIMATE_ENABLED stays false. Other writers fall back to "Administrator".
    "ERPNEXT_INTEGRATION_USER": "",
    "OPERATING_AUTOMATION_USER": "ironwrap-worker",
    "PUBLIC_ESTIMATE_ENABLED": "false",
    "PUBLIC_ESTIMATE_ALLOWED_ORIGINS": "",
    "PUBLIC_ESTIMATE_ALLOWED_BRANDS": "",
    "PUBLIC_ESTIMATE_CONSENT_JURISDICTION": "",
    "PUBLIC_ESTIMATE_ALLOW_INSECURE_LOCAL": "false",
    "PUBLIC_ESTIMATE_TURNSTILE_SITE_KEY": "",
    "PUBLIC_ESTIMATE_RATE_LIMIT_WINDOW_SECONDS": "",
    "PUBLIC_ESTIMATE_RATE_LIMIT_IP_MAX": "",
    "PUBLIC_ESTIMATE_RATE_LIMIT_CLIENT_MAX": "",
    "PUBLIC_ESTIMATE_RANGE_RULES_JSON": "",
    // Authenticated PWA surfaces. Turning this on adds three hard readiness requirements:
    // APP_PUBLIC_ORIGIN, a matching APP_ALLOWED_ORIGINS entry, and an APP_AUTH_PEPPER
    // secret of at least 32 characters. Magic-link email goes through Gmail in production
    // (the dev_outbox capture is localhost-only).
    "APP_BFF_ENABLED": "true",
    "APP_HERMES_DESKTOP_ENABLED": "false",
    "APP_CUSTOMER_PORTAL_ENABLED": "true",
    "APP_CUSTOMER_CONTRACT_ACCEPTANCE_ENABLED": "true",
    "APP_CUSTOMER_PORTAL_DECISION_ENABLED": "true",
    "FACET_DESIGN_INGEST_ENABLED": "false",
    "FACET_DESIGN_INGEST_TENANT_MAP_JSON": "{}",
    "FACET_V2_INGEST_ENABLED": "true",
    "FACET_V2_ROUTES_JSON": "[]",
    "FACET_V2_NATIVE_PROJECTION_ENABLED": "true",
    "FACET_DESIGN_FRAPPE_PROJECTION_ENABLED": "false",
    "APP_FACET_QUOTE_REVISION_PREPARE_ENABLED": "false",
    "APP_PROPOSAL_PUBLICATION_ENABLED": "false",
    "APP_FACET_LAUNCH_ENABLED": "true",
    "APP_FACET_LAUNCH_BASE_URL": "",
    "APP_FACET_LAUNCH_SOURCE_TENANT_ID": "",
    "POSTIZ_ENABLED": "false",
    "POSTIZ_EXPECTED_VERSION": "v2.23.0",
    "POSTIZ_API_BASE_URL": "",
    "POSTIZ_API_TIMEOUT_MS": "10000",
    "POSTIZ_ALLOWED_PROVIDERS": "facebook,linkedin-page,gmb",
    "POSTIZ_FACET_DRAFT_ENABLED": "false",
    "POSTIZ_FACET_DRAFT_PROVIDER": "facebook",
    "POSTIZ_FACET_DRAFT_OFFSET_HOURS": "168",
    "POSTIZ_FACET_DRAFT_NOT_BEFORE": "",
    // Tenant pricing for the estimator's computed estimate; empty disables pricing.
    "ESTIMATOR_PRICE_LIST_JSON": "",
    // Google Doc template id for proposal generation; empty disables the action.
    "PROPOSAL_TEMPLATE_DOC_ID": "",
    "APP_TENANT_ID": "ironwrap",
    "APP_TENANT_NAME": "IronWrap OS",
    "APP_TENANT_BRAND": "IronWrap",
    "APP_LOCALE": "en-CA",
    "APP_TIME_ZONE": "America/Edmonton",
    "APP_CURRENCY": "CAD",
    // Required by APP_BFF_ENABLED: appPublicOrigin() returns null unless APP_PUBLIC_ORIGIN
    // is non-empty AND listed in APP_ALLOWED_ORIGINS. Keep both bound to the declared
    // production custom domain so login links and origin checks match the release smoke URL.
    "APP_PUBLIC_ORIGIN": "https://ironwrap-bus.ironwrapexteriors.com",
    "APP_ALLOWED_ORIGINS": "https://ironwrap-bus.ironwrapexteriors.com",
    "APP_ALLOW_INSECURE_LOCAL": "false",
    "APP_FIRST_OWNER_BOOTSTRAP_ENABLED": "false",
    "APP_FRAPPE_REQUEST_TIMEOUT_MS": "8000",
    "APP_INSURANCE_ESTIMATOR_FRAPPE_USERS": "",
    "APP_VISUAL_PREVIEW_ALLOWED_ORIGINS": "",
    "APP_APPROVAL_BROKER_URL": "",
    "APP_APPROVAL_BROKER_KEY_ID": "",
    "APP_APPROVAL_APPROVER_ID": "",
    "APP_APPROVAL_MAX_SESSION_AGE_SECONDS": "900",
    "APP_APPROVAL_BROKER_TIMEOUT_MS": "15000",
    "APP_APPROVAL_EXECUTION_LEASE_SECONDS": "45",
    "APP_QUOTE_REVISION_BROKER_URL": "",
    "APP_QUOTE_REVISION_BROKER_KEY_ID": "",
    "APP_QUOTE_REVISION_BROKER_TIMEOUT_MS": "15000",
    "APP_QUOTE_REVISION_EXECUTION_LEASE_SECONDS": "45",
    "APP_PROPOSAL_PUBLICATION_BROKER_URL": "",
    "APP_PROPOSAL_PUBLICATION_BROKER_KEY_ID": "",
    "APP_PROPOSAL_PUBLICATION_BROKER_TIMEOUT_MS": "15000",
    "APP_PROPOSAL_PUBLICATION_EXECUTION_LEASE_SECONDS": "45",
    "APP_PRODUCTION_SCHEDULE_BROKER_URL": "",
    "APP_PRODUCTION_SCHEDULE_BROKER_KEY_ID": "",
    "APP_PRODUCTION_SCHEDULE_APPROVER_ID": "",
    "APP_PRODUCTION_SCHEDULE_MAX_SESSION_AGE_SECONDS": "900",
    "APP_PRODUCTION_SCHEDULE_BROKER_TIMEOUT_MS": "15000",
    "APP_PRODUCTION_SCHEDULE_EXECUTION_LEASE_SECONDS": "45",
    "DEDUP_WINDOW_HOURS": "72",
    "STUCK_THRESHOLD_MIN": "15",
    "SHARED_DRIVE_ID_JOBS": "0AHqXhIQ3svySUk9PVA",
    "SHARED_DRIVE_ID_RESTRICTED": "0AMufCVvWaztwUk9PVA",
    "SHARED_DRIVE_ID_ARCHIVE": "0AFTfvKuo0_6uUk9PVA"
  },

  // Isolated owner-test environment. Every non-inheritable binding and variable
  // is repeated here so `wrangler deploy --env staging` cannot reach production data.
  // Local end-to-end development environment (`wrangler dev --env local`, wired by
  // `npm run dev` + deploy/local/predev.mjs). Bindings are inherited shape-only; wrangler
  // dev serves D1/R2/queues from local Miniflare state. Wrangler envs REPLACE top-level
  // vars wholesale, so every production var is repeated here with local-safe values:
  // bridge rails (JobNimbus/Drive) are OFF, the BFF + public estimator are ON against the
  // throwaway deploy/local Frappe stack, and Turnstile uses Cloudflare's published
  // always-pass test keys. Never points at production data.
  "env": {
    "local": {
      "workers_dev": true,
      "routes": [],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "ironwrap-bus",
          "database_id": "f0674848-13df-4422-9896-8ba2719663b8",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        { "binding": "RAW", "bucket_name": "ironwrap-bus-raw" }
      ],
      "queues": {
        "producers": [
          { "binding": "JN_QUEUE", "queue": "ironwrap-jn-push" },
          { "binding": "MEASUREMENT_QUEUE", "queue": "ironwrap-local-measurements" }
        ],
        "consumers": [
          {
            "queue": "ironwrap-jn-push",
            "max_retries": 5,
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "dead_letter_queue": "ironwrap-jn-dlq"
          },
          { "queue": "ironwrap-jn-dlq", "max_retries": 1 },
          {
            "queue": "ironwrap-local-measurements",
            "max_retries": 5,
            "max_batch_size": 1,
            "max_batch_timeout": 1,
            "dead_letter_queue": "ironwrap-local-measurements-dlq"
          },
          { "queue": "ironwrap-local-measurements-dlq", "max_retries": 1 }
        ]
      },
      "vars": {
        "OWNER_ALERT_EMAIL": "info@ironwrapexteriors.com",
        "BACKUP_ALERT_EMAIL": "sales@ironwrapexteriors.com",
        "FROM_EMAIL": "sales@ironwrapexteriors.com",
        "EFFECT_RUNTIME_ENABLED": "true",
        "APP_DOCUMENT_GENERATION_ENABLED": "false",
        "PIPELINE_AUTOMATION_ENABLED": "false",
        "JOBNIMBUS_ENABLED": "false",
        "MEASUREMENT_OCR_ENABLED": "true",
        "MEASUREMENT_OCR_MODEL": "claude-opus-5",
        "OMNIROUTE_URL": "",
        "NEWO_PRODUCTION_REQUIRED": "false",
        "NEWO_ENABLED": "false",
        "NEWO_CONTROL_WRITE_ENABLED": "false",
        "NEWO_BOOKING_MODE": "request_only",
        "NEWO_OUTBOUND_ENABLED": "false",
        "NEWO_API_BASE_URL": "https://api.newo.ai",
        "NEWO_PROJECT_ID": "",
        "NEWO_AGENT_ID": "",
        "NEWO_REPORT_WEBHOOK_ID": "",
        "NEWO_REPORT_WEBHOOK_URL": "",
        "NEWO_HANDOFF_WEBHOOK_ID": "",
        "NEWO_HANDOFF_WEBHOOK_URL": "",
        "NEWO_PROTECTED_WEBHOOK_IDS": "",
        "NEWO_EXPECTED_CONFIG_VERSION": "newo.production.v1",
        "NEWO_TOOL_SCHEMA_SHA256": "6d1028836d51f25a42cf0b38660ccf5d7f624f5396616ebd2c5168b16a1554fa",
        "NEWO_REPORT_SCHEMA_SHA256": "5c587d4c53b872fbef4290a315ecc7e00477371168b1ac4a07735fff695602cb",
        "NEWO_KB_VERSION": "ironwrap-receptionist.v1",
        "NEWO_KB_SHA256": "9549fdf4956053b84e261f4909e31a8b072599cd2dcae7aa85861d4592a9aa64",
        "NEWO_PHONE_NUMBER": "",
        "NEWO_ENABLED_CHANNELS": "voice",
        "NEWO_TRANSFER_POLICY": "owner_then_voicemail",
        "NEWO_OWNER_TRANSFER_NUMBER": "",
        "NEWO_R2_LIFECYCLE_PROVEN": "false",
        "NEWO_USAGE_LIMIT_MINUTES": "",
        "NEWO_USAGE_ALERT_PERCENT": "80",
        "NEWO_JOBNIMBUS_BOOKING_PROVEN": "false",
        "NEWO_CALLBACK_OWNER_USER": "",
        "NEWO_BOOKING_HORIZON_DAYS": "30",
        "NEWO_REPORT_TIMEOUT_MINUTES": "30",
        "NEWO_SYNC_RETRY_MINUTES": "5",
        "NEWO_API_TIMEOUT_MS": "10000",
        "NEWO_CONTROL_RECEIPT_TTL_SECONDS": "600",
        "JN_CONTACT_RECORD_TYPE": "Customer",
        "JN_CONTACT_STATUS": "New",
        "JN_JOB_RECORD_TYPE": "Retail",
        "JN_JOB_STATUS": "Lead",
        "ERPNEXT_ENABLED": "true",
        // Default single-stack ports only. This file is static JSON and cannot read the
        // environment, so predev.mjs re-declares every port-bearing local value into
        // .dev.vars from IRONWRAP_LOCAL_FRAPPE_PORT / IRONWRAP_LOCAL_WORKER_PORT /
        // IRONWRAP_LOCAL_BROKER_PORT_BASE, and wrangler dev loads those over these.
        // Editing a port here moves only the default; see deploy/local/README.md.
        "ERPNEXT_BASE_URL": "http://localhost:8000",
        "QB_EXPECTED_REALM_ID": "",
        "QB_RECONCILIATION_ISSUER_USER": "ironwrap-quickbooks-issuer@ironwrap.local",
        "QB_OAUTH_ENABLED": "false",
        "QB_FINAL_INVOICE_ENABLED": "false",
        "QB_API_ENVIRONMENT": "sandbox",
        "QB_API_MINOR_VERSION": "75",
        "QB_API_TIMEOUT_MS": "10000",
        "QB_TOKEN_ENCRYPTION_KEY_VERSION": "",
        "ERPNEXT_LEAD_ENVELOPE_DOCTYPE": "Lead Envelope",
        "ERPNEXT_INTEGRATION_USER": "ironwrap-bus@ironwrap.local",
        "OPERATING_AUTOMATION_USER": "ironwrap-worker",
        "PUBLIC_ESTIMATE_ENABLED": "true",
        "PUBLIC_ESTIMATE_ALLOWED_ORIGINS": "http://localhost:7100",
        "PUBLIC_ESTIMATE_ALLOWED_BRANDS": "ironwrap,iroof",
        "PUBLIC_ESTIMATE_CONSENT_JURISDICTION": "Alberta, Canada",
        "PUBLIC_ESTIMATE_ALLOW_INSECURE_LOCAL": "true",
        "PUBLIC_ESTIMATE_TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
        "PUBLIC_ESTIMATE_RATE_LIMIT_WINDOW_SECONDS": "60",
        "PUBLIC_ESTIMATE_RATE_LIMIT_IP_MAX": "30",
        "PUBLIC_ESTIMATE_RATE_LIMIT_CLIENT_MAX": "10",
        "PUBLIC_ESTIMATE_RANGE_RULES_JSON": "[]",
        "APP_BFF_ENABLED": "true",
        "APP_HERMES_DESKTOP_ENABLED": "false",
        "APP_CUSTOMER_PORTAL_ENABLED": "true",
        "APP_CUSTOMER_CONTRACT_ACCEPTANCE_ENABLED": "true",
        "APP_CUSTOMER_PORTAL_DECISION_ENABLED": "true",
        "FACET_DESIGN_INGEST_ENABLED": "false",
        "FACET_DESIGN_INGEST_TENANT_MAP_JSON": "{}",
        "FACET_V2_INGEST_ENABLED": "true",
        "FACET_V2_ROUTES_JSON": "[{\"version\":1,\"issuer\":\"facet\",\"source_product\":\"facet\",\"source_environment\":\"local\",\"source_tenant_id\":\"0b6f0d5a-2f1c-4a3e-8c7d-5e9a1b2c3d4e\",\"destination_tenant_id\":\"ironwrap\",\"destination_url\":\"https://bus.local.test:7443/ingest/facet-design\"}]",
        "FACET_V2_NATIVE_PROJECTION_ENABLED": "true",
        "FACET_DESIGN_FRAPPE_PROJECTION_ENABLED": "false",
