          "NEWO_TOOL_SCHEMA_SHA256": "6d1028836d51f25a42cf0b38660ccf5d7f624f5396616ebd2c5168b16a1554fa",
          "NEWO_REPORT_SCHEMA_SHA256": "5c587d4c53b872fbef4290a315ecc7e00477371168b1ac4a07735fff695602cb",
          "NEWO_KB_VERSION": "ironwrap-receptionist.v1",
          "NEWO_KB_SHA256": "9549fdf4956053b84e261f4909e31a8b072599cd2dcae7aa85861d4592a9aa64",
          "NEWO_PHONE_NUMBER": "",
          "NEWO_ENABLED_CHANNELS": "voice",
          "NEWO_TRANSFER_POLICY": "owner_then_voicemail",
          "NEWO_OWNER_TRANSFER_NUMBER": "",
          "NEWO_R2_LIFECYCLE_PROVEN": "false",
          "NEWO_USAGE_LIMIT_MINUTES": "",
          "NEWO_USAGE_ALERT_PERCENT": "80",
          "NEWO_JOBNIMBUS_BOOKING_PROVEN": "false",
          "NEWO_CALLBACK_OWNER_USER": "",
          "NEWO_BOOKING_HORIZON_DAYS": "30",
          "NEWO_REPORT_TIMEOUT_MINUTES": "30",
          "NEWO_SYNC_RETRY_MINUTES": "5",
          "NEWO_API_TIMEOUT_MS": "10000",
          "NEWO_CONTROL_RECEIPT_TTL_SECONDS": "600"
        },
        // The public estimate form stays off in qa: it is an unauthenticated form on a public
        // address, so on qa it would collect real people's details into an environment that holds
        // synthetic data only, and it needs a Turnstile widget and rate-limit pepper for this host.
        "CFG_PUBLIC": {
          "PUBLIC_ESTIMATE_ENABLED": "false",
          "PUBLIC_ESTIMATE_ALLOWED_ORIGINS": "",
          "PUBLIC_ESTIMATE_ALLOWED_BRANDS": "",
          "PUBLIC_ESTIMATE_CONSENT_JURISDICTION": "",
          "PUBLIC_ESTIMATE_ALLOW_INSECURE_LOCAL": "false",
          "PUBLIC_ESTIMATE_TURNSTILE_SITE_KEY": "",
          "PUBLIC_ESTIMATE_RATE_LIMIT_WINDOW_SECONDS": "",
          "PUBLIC_ESTIMATE_RATE_LIMIT_IP_MAX": "",
          "PUBLIC_ESTIMATE_RATE_LIMIT_CLIENT_MAX": "",
          "PUBLIC_ESTIMATE_RANGE_RULES_JSON": ""
        },
        // Postiz publishes to real social accounts, and qa has no Postiz instance.
        "CFG_POSTIZ": {
          "POSTIZ_ENABLED": "false",
          "POSTIZ_EXPECTED_VERSION": "v2.23.0",
          "POSTIZ_API_BASE_URL": "",
          "POSTIZ_API_TIMEOUT_MS": "10000",
          "POSTIZ_ALLOWED_PROVIDERS": "facebook,linkedin-page,gmb",
          "POSTIZ_FACET_DRAFT_ENABLED": "false",
          "POSTIZ_FACET_DRAFT_PROVIDER": "facebook",
          "POSTIZ_FACET_DRAFT_OFFSET_HOURS": "168",
          "POSTIZ_FACET_DRAFT_NOT_BEFORE": ""
        },
        // QuickBooks stays off in qa until an Intuit sandbox app exists for it (QB_CLIENT_ID,
        // QB_CLIENT_SECRET, QB_TOKEN_ENCRYPTION_KEY); qa never connects the production company.
        "CFG_QB": {
          "QB_EXPECTED_REALM_ID": "",
          "QB_RECONCILIATION_ISSUER_USER": "",
          "QB_OAUTH_ENABLED": "false",
          "QB_FINAL_INVOICE_ENABLED": "false",
