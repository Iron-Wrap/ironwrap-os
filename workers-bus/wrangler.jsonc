          "APP_APPROVAL_APPROVER_ID": "",
          "APP_APPROVAL_MAX_SESSION_AGE_SECONDS": "900",
          "APP_APPROVAL_BROKER_TIMEOUT_MS": "15000",
          "APP_APPROVAL_EXECUTION_LEASE_SECONDS": "45",
          "APP_QUOTE_REVISION_BROKER_URL": "",
          "APP_QUOTE_REVISION_BROKER_KEY_ID": "",
          "APP_QUOTE_REVISION_BROKER_TIMEOUT_MS": "15000",
          "APP_QUOTE_REVISION_EXECUTION_LEASE_SECONDS": "45",
          "APP_PROPOSAL_PUBLICATION_BROKER_URL": "",
          "APP_PROPOSAL_PUBLICATION_BROKER_KEY_ID": "",
          "APP_PROPOSAL_PUBLICATION_BROKER_TIMEOUT_MS": "15000",
          "APP_PROPOSAL_PUBLICATION_EXECUTION_LEASE_SECONDS": "45",
          "APP_PRODUCTION_SCHEDULE_BROKER_URL": "",
          "APP_PRODUCTION_SCHEDULE_BROKER_KEY_ID": "",
          "APP_PRODUCTION_SCHEDULE_APPROVER_ID": "",
          "APP_PRODUCTION_SCHEDULE_MAX_SESSION_AGE_SECONDS": "900",
          "APP_PRODUCTION_SCHEDULE_BROKER_TIMEOUT_MS": "15000",
          "APP_PRODUCTION_SCHEDULE_EXECUTION_LEASE_SECONDS": "45"
        },
        "CFG_NEWO": {
          // Newo is not required in qa until it is enabled there separately (owner
          // decision, 2026-09-27); with it required, every newo_* /ready check fails the
          // release smoke.
          "NEWO_PRODUCTION_REQUIRED": "false",
          "NEWO_ENABLED": "false",
          "NEWO_CONTROL_WRITE_ENABLED": "false",
          "NEWO_BOOKING_MODE": "request_only",
          "NEWO_OUTBOUND_ENABLED": "false",
          "NEWO_API_BASE_URL": "https://api.newo.ai",
          "NEWO_PROJECT_ID": "",
          "NEWO_AGENT_ID": "",
          "NEWO_REPORT_WEBHOOK_ID": "",
          "NEWO_REPORT_WEBHOOK_URL": "",
          "NEWO_HANDOFF_WEBHOOK_ID": "",
          "NEWO_HANDOFF_WEBHOOK_URL": "",
          "NEWO_PROTECTED_WEBHOOK_IDS": "",
